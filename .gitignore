# Whatever any Python next to it leaves behind. This named client/tools alone
# until deploy/discord grew a script and left one of these too.
__pycache__/
tools/pilot/libvwprobe.so

# The identity a running arena writes for itself, per host, not per repo.
zone/instance-id
# An arena writes one beside itself, so a server run from the repository root
# leaves one here too.
/instance-id

# The browser bundle. Built and published by CI as an image
# (.github/workflows/client.yml), not committed: it was 5 MB of git history per
# release and a step somebody had to remember, and forgetting it cost an outage.
client/dist/

# The 3D ship mock renders its own tool and its own battle recordings.
.design/ships3d/mock3d
.design/ships3d/*.vwcap
