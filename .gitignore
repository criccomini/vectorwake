sim/build/
sim/build2/
server/target/
client/ext/simcore/src/sim.c
client/ext/simcore/src/baseline.c
client/ext/simcore/src/pack.c
client/ext/simcore/src/sintab.h
client/ext/simcore/include/sim/
client/build/
client/.internal/
client/bundle/
# Secrets and per-host state for a deployment: generated, never committed.
deploy/.env
deploy/deploy-log/
sandbox-ca.crt

# What the calibration harnesses write where they were run. Both are
# measurements to diff a change against rather than inputs anything loads, so
# a tuning session should not leave the tree dirty.
hulls.json
ladder.json

# Built by hand when somebody wants to hear the kit outside the game, and by
# `make -C client/tools check` when CI wants to measure it.
client/tools/sfxdump
client/tools/sfxladder
client/tools/smoothcheck
client/tools/flightcheck
# Whatever any Python next to it leaves behind. This named client/tools alone
# until deploy/discord grew a script and left one of these too.
__pycache__/
tools/pilot/libvwprobe.so

# The identity a running arena writes for itself, per host, not per repo.
zone/instance-id
# An arena writes one beside itself, so a server run from the repository root
# leaves one here too.
/instance-id

# The browser bundle. Built and published by CI as an image
# (.github/workflows/client.yml), not committed: it was 5 MB of git history per
# release and a step somebody had to remember, and forgetting it cost an outage.
client/dist/

# The seeded design canvases under .design/. Each is the whole canvas editor
# with the boards baked into it, two and a half megabytes for boards that come
# to a hundred kilobytes of source beside it, and `build.py` plus the design
# skill's seeder rebuild one whenever it is wanted. Same argument as
# client/dist above. A hand-written mock that is a page rather than a canvas
# is small and stays, so the pattern only catches the seeded ones.
.design/*/[a-z]*-*.html
