-- The arena screen.
--
-- This script owns the frame loop and nothing else about the game. It reads
-- input, calls the simulation core, and draws what the core says is true. No
-- game rule is implemented in Lua, per decision 5: Defold's component update
-- order within a collection is unspecified, and HTML5 builds run Lua 5.1.4
-- rather than LuaJIT, so state distributed across scripts would have neither
-- a defined order nor adequate speed on the platform that matters most.
--
-- Every game is a zone on a server. The client predicts its own ship and
-- draws what arrives; it owns no roster and flies no bots. Before a zone
-- answers there is no world at all, only a starfield with the menu over it.
--
-- Drawing is five mesh layers, built here and in arena/world.lua and
-- arena/ui.lua, and uploaded once each per frame. It used to be
-- `draw_debug3d`, which is one pixel wide, one blend mode, and compiled out
-- of release builds entirely: a shipped bundle drew an empty arena.

local net = require("arena.net")
local touch = require("arena.touch")
local account = require("arena.account")
local directory = require("arena.directory")
local menu = require("arena.menu")
local pal = require("arena.palette")
local world = require("arena.world")
local fx = require("arena.fx")
local sfx = require("arena.sfx")
local ui = require("arena.ui")
local vec = require("render.vec")

local TICK_HZ = 100
local DT = 1 / TICK_HZ
local MAX_CATCHUP = 8      -- ticks per frame; a long stall must not stampede
local DETAIL_R2 = world.DETAIL_RANGE * world.DETAIL_RANGE

-- The drawn cursor holds for this long after the mouse stops, then fades out
-- over the second span. Long enough that a read of the scoreboard does not
-- lose the pointer mid-thought, short enough that a keyboard flight is not
-- flown around an arrow parked in the middle of the screen.
local CURSOR_HOLD = 2.0
local CURSOR_FADE = 0.5

local CLASS_NAMES = {"Apex", "Wedge", "Chord", "Anvil",
                     "Spire", "Cipher", "Facet", "Lattice"}

local held = {}
-- A tap can go down and up inside one frame, so the frame loop never sees it
-- in `held`. Presses are latched here and consumed by whatever reads them,
-- which is how the menu gets a keystroke that flight does not need.
local tapped = {}
local me = 0
local accum = 0
local feed = {}
local hurt = 0
local pickup = nil
-- Per-seat bank state, described where it is used further down. Declared up
-- here because go_home clears it, and a local declared below the function that
-- reads it is not the same variable: the function closes over a global that is
-- nil, and clearing it throws on the way out of every zone.
local rolls = {}
local layers = nil
-- The terrain window, in tiles either side of the camera, and how far the
-- camera may walk before it is rebuilt. A map is 1024 tiles square, so what
-- gets meshed is a window rather than the map.
--
-- It follows the view, and has to. The camera holds a fixed zoom per decision
-- 13, so a wider window sees further rather than seeing the same thing
-- bigger: half the window in tiles is the drawable's half-width over sixteen.
-- This was 56, a constant, written against "a view about 20 tiles wide" and
-- correct for exactly one size of browser. At 1280 CSS pixels the view is 40
-- tiles either side and 56 leaves precisely one rebuild's margin; past that
-- the margin goes negative and terrain stops in mid air, short of an edge the
-- player can plainly see over. Rebuilding does not close it, because the
-- window is recentred rather than widened, which is why it reads as a gap
-- that follows you.
local STATIC_STEP = 16
-- What a 1280-wide window needs, and the floor: a window smaller than this
-- gains nothing from meshing less, and the home screen has no viewport yet.
local STATIC_MIN = 56
-- A ceiling on one rebuild, in tiles either side. The window is meshed whole
-- and held whole, so its cost is the square of this: 137 is a 3840-wide
-- drawable with its rebuild margin intact, and asks about 22 MB of the two
-- static layers. Past it the old gap comes back, far out, which is the trade
-- against a client that would otherwise ask for hundreds of megabytes on a
-- wall display. Note this is CSS pixels rather than device ones: a dense
-- display folds its density into the zoom, so a retina laptop sees the same
-- amount of world as a plain one and asks for the same window.
local STATIC_MAX = 137
local static_half = STATIC_MIN
-- What a static layer starts at before any build has said what it needs, and
-- the floor it is never taken below. The window is meshed rarely and drawn
-- always, so what a capacity really costs is a per-frame one: the mesh
-- component submits the whole buffer every frame, degenerate or not, and a
-- capacity chosen for the densest tile of the map is paid for over the empty
-- ones too. So these are a starting guess and `fit_static` below moves them.
local STATIC_SEED = 16384
local STATIC_FLOOR = 8192
local static_tx, static_ty = nil, nil
-- Forward declared: leaving a zone is reached both from a menu row and from a
-- socket that dropped, and one of those runs above the place that knows what
-- a menu action means.
local apply_menu
local go_home

-- HTML5 builds run Lua 5.1, which has no bitwise operators. Every bitfield in
-- this client is a sum of distinct powers of two, so a digit test is exact.
local function has(bits, bit)
    return math.floor(bits / bit) % 2 == 1
end

-- Defold hands on_input a hashed action_id, never the string it was written
-- as in the input binding. Comparing it to a string literal silently yields
-- false for every key ever pressed, which is exactly what it did.
local ACTION_BITS = nil
local function bit_for(action)
    if not ACTION_BITS then
        ACTION_BITS = {
            [hash("turn_left")] = sim.BTN_LEFT,
            [hash("turn_right")] = sim.BTN_RIGHT,
            [hash("thrust")] = sim.BTN_THRUST,
            [hash("reverse")] = sim.BTN_REVERSE,
            [hash("guns")] = sim.BTN_FIRE,
            [hash("bombs")] = sim.BTN_BOMB,
            -- Held rather than tapped here on purpose: the core toggles on the
            -- rising edge, so the client's job is only to report the key, and
            -- doing the edge here as well would make two places that have to
            -- agree about one press.
            [hash("multi")] = sim.BTN_MULTI,
            -- The mouse buttons are their own actions rather than aliases of
            -- guns and bombs. A browser synthesises a click from every touch,
            -- so while they shared a name, one tap anywhere on a phone was a
            -- trigger pull, and a menu row read a trigger pull as a choice.
            [hash("pointer")] = sim.BTN_FIRE,
            [hash("pointer_alt")] = sim.BTN_BOMB,
            -- Continuum's own gun key, honoured only under the keyboard lock:
            -- see the gate in my_buttons.
            [hash("guns_ctrl")] = sim.BTN_FIRE,
        }
    end
    return ACTION_BITS[action] or 0
end

-- Whether the page holds the keyboard lock, polled from the fullscreen state
-- once a second. While it is held, Ctrl fires guns and the layout is the
-- original's outright. While it is not, Ctrl does nothing at all, which is
-- the honest reading of a key the browser owns half of: windowed, Ctrl with
-- Tab switches tabs on every platform and no preventDefault is consulted, so
-- a Ctrl that fired would be a trap sprung by the game's commonest chord.
local kb_locked = false

-- The charge slots this hull can ever carry, in order. An empty list means a
-- hull with no charges at all, and the row simply is not drawn.
local function my_slots()
    local out = {}
    for k = 0, sim.MAX_CHARGES - 1 do
        if sim.charge_max(me, k) > 0 then out[#out + 1] = k end
    end
    return out
end

-- The charge a pad asked for this frame, read from the latch once and held
-- until the step has used it.
--
-- It cannot be consumed inside `my_buttons`: that runs more than once a frame,
-- for the network, for the simulation and to know whether to draw an engine
-- flame, so the first call would swallow the tap and the one that mattered
-- would see nothing.
local charge_tap = nil
-- The same latch for a digit key, filled where taps are read and drained into
-- `charge_tap` by the step loop.
local key_charge = nil

local function my_buttons()
    if menu.open then return 0 end
    -- Collected as a set of distinct bits and summed, rather than or-ed:
    -- HTML5 builds run Lua 5.1, which has no bitwise operators, and a bit
    -- contributed by both the keyboard and the stick must still count once.
    local bits = {}
    local steering = touch.steering()
    for action, down in pairs(held) do
        -- Defold raises a mouse action for every touch as well as the touch
        -- itself. On a phone that made the whole screen a trigger: putting a
        -- thumb down to steer fired the guns, and there was no way to turn
        -- without shooting. Once a device has shown it has a touchscreen the
        -- emulated pointer is ignored and the pads are the only triggers.
        local emulated = touch.used and (action == hash("pointer")
                                         or action == hash("pointer_alt"))
        -- Ctrl is a gun only while the keyboard lock holds. Gated here rather
        -- than at the binding, because the binding cannot know and a Ctrl that
        -- spent a charge or fired unlocked would be worse than one that does
        -- nothing.
        local unlocked_ctrl = action == hash("guns_ctrl") and not kb_locked
        if down and not emulated and not unlocked_ctrl then
            -- Two sources on the rudder would fight; the stick wins while it
            -- is down, and the keys keep everything else.
            local bit = bit_for(action)
            local rudder = bit == sim.BTN_LEFT or bit == sim.BTN_RIGHT
            if not (steering and rudder) then bits[bit] = true end
        end
    end
    -- Raw: the stick compares the swipe against where the nose actually is,
    -- and a heading eased for the screen is not a fact about the ship.
    for _, bit in ipairs(touch.bits(sim.ship_heading_raw(me))) do
        bits[bit] = true
    end
    -- A spend names its own slot, whichever control asked: a pad's tap and a
    -- digit's press land in the same latch, so there is no selection anywhere
    -- to read back or to have forgotten to move. The control you pressed is
    -- the thing you get.
    if charge_tap then bits[sim.BTN_USE] = true end

    local b = 0
    for bit in pairs(bits) do b = b + bit end
    -- Which charge is spent rides in the buttons rather than in the
    -- simulation: selection is a thing a pilot does with their own interface,
    -- so it costs no snapshot byte and no edge detection down in the core.
    return b + (charge_tap or 0) * sim.BTN_SLOT_STEP
end

-- What the panel draws: every slot this hull can carry, how many are in
-- hand, and which one the use key would spend.
local function charge_row()
    local out = {}
    for _, k in ipairs(my_slots()) do
        local c = pal.CHARGES[k + 1]
        out[#out + 1] = {
            short = c and c.short or "C",
            -- The full word, because the corner stack has room for it and
            -- "RPL" is three letters nobody has been taught.
            name = c and c.name or "charge",
            count = sim.ship_charge(me, k),
            -- How many this hull can hold, so the row can draw the empties
            -- as well as the full ones.
            max = sim.charge_max(me, k),
        }
    end
    return out
end

-- The menu and the info panels are the same kind of thing, a slab of text
-- laid over a fight that does not pause for it, so they are one at a time.
-- Opening either shuts the other. Two of them at once was the exact thing the
-- HUD pass existed to stop, arrived at from a different direction.
local function toggle_menu()
    if menu.toggle() then ui.details = false end
end

local function toggle_details()
    ui.details = not ui.details
    if ui.details then menu.close() end
end

-- The map is not one of those. It is an instrument rather than a slab of
-- text: it stands in the radar's corner, it covers no more of the fight than
-- the radar already did, and reading it while the scoreboard is up is a
-- reasonable thing to want. So it toggles on its own and shuts nothing.
local function toggle_map()
    ui.map = not ui.map
end

-- The terrain and the starfield never move, so they are built once per map
-- rather than per frame. Rebuilding them was the single most expensive thing
-- the old renderer did, and it did it sixty times a second.
-- What the two static layers should hold next time, decided by what they held
-- last time. Applied before the next build rather than after this one, because
-- resizing hands a layer an empty buffer and rebuilding twice to fill it would
-- put the whole cost of the change into one frame.
local bg_want, bgglow_want = nil, nil

-- Choose a capacity from what a build actually used.
--
-- Density varies across a map far more than the window size does: a window of
-- open space costs almost nothing to mesh and the middle of Chaos costs
-- everything. Sizing for the worst tile everywhere is what made the layers
-- expensive, since the whole buffer is drawn every frame whether it holds
-- geometry or not.
--
-- Half again as much as the last build is the target. It is enough that
-- ordinary drift across a map does not touch the capacity at all, and the
-- band below is wide enough that a layer does not thrash between two sizes on
-- a ship flying back and forth across one wall.
local function fit_static(layer, dropped)
    local used = layer.n + dropped
    local want = math.max(STATIC_FLOOR, math.ceil(used * 1.5))
    if used > layer.cap * 0.9 or want < layer.cap * 0.55 then
        return want
    end
    return nil
end

local function rebuild_static(tx, ty)
    if not layers then return end
    if not tx then
        -- Whatever is on screen, or the middle of the map before anything is.
        if sim.ship_count() > 0 then
            tx = math.floor(sim.ship_x(me) / 16)
            ty = math.floor(sim.ship_y(me) / 16)
        else
            tx, ty = 512, 512
        end
    end
    static_tx, static_ty = tx, ty
    -- Spawns and goals are drawn in the colour of whoever owns them, and the
    -- terrain is built long before the frame that draws a ship, so the team
    -- goes in here rather than being passed down every call.
    world.my_team = (sim.ship_count() > 0) and sim.ship_team(me) or 0
    -- Whatever the last build asked for, before this one writes anything.
    if bg_want then layers.bg:resize(bg_want); bg_want = nil end
    if bgglow_want then layers.bgglow:resize(bgglow_want); bgglow_want = nil end
    world.build_static(layers.bg, layers.bgglow,
                       tx - static_half, ty - static_half,
                       tx + static_half, ty + static_half)
    -- What this one turned out to need. A layer that dropped geometry is
    -- short right now rather than next time, so it is rebuilt at once; that
    -- is the one case worth paying two builds for, because the alternative is
    -- terrain missing from the screen until the camera happens to move.
    bg_want = fit_static(layers.bg, layers.bg.dropped)
    bgglow_want = fit_static(layers.bgglow, layers.bgglow.dropped)
    if layers.bg.dropped > 0 or layers.bgglow.dropped > 0 then
        if bg_want then layers.bg:resize(bg_want); bg_want = nil end
        if bgglow_want then layers.bgglow:resize(bgglow_want); bgglow_want = nil end
        world.build_static(layers.bg, layers.bgglow,
                           tx - static_half, ty - static_half,
                           tx + static_half, ty + static_half)
    end
end

-- No terrain at all, which is what the home screen wants. The static layers
-- hold whatever map was last built, and a menu over the walls of the zone you
-- just left reads as a game still running behind it.
local function clear_static()
    world.forget_overview()
    if not layers then return end
    layers.bg:reset()
    layers.bg:flush()
    layers.bgglow:reset()
    layers.bgglow:flush()
    static_tx, static_ty = nil, nil
end

-- Back to the menu with nothing behind it.
--
-- Every way out of a zone lands here: the leave row, a socket that dropped, a
-- join that was never answered, and the first frame of the whole client. The
-- note is deliberately not cleared, because most of the callers have just set
-- one and it is the only thing that will say what went wrong.
function go_home(self, at)
    net.disconnect()
    self.online = false
    self.joining = nil
    feed = {}
    pickup = nil
    hurt = 0
    -- A box about somebody in the room you just left describes a seat number
    -- that the next room will have dealt to a stranger.
    ui.inspect = nil
    -- The next zone deals these seats to different pilots.
    for k in pairs(rolls) do rolls[k] = nil end
    fx.reset()
    -- Leaving a zone re-derives the tables from the baseline, so what a spec
    -- id means changes on the way out of one as well as into it.
    world.forget_specs()
    -- An empty world. Nothing is drawn from it, but the core is what the next
    -- connection unpacks a snapshot into, and it must not be holding the last
    -- zone's map and settings when that happens.
    sim.init(0x5eed)
    clear_static()
    me = 0
    ui.details = false
    ui.map = false
    menu.home = true
    menu.show(at)
    -- The call sign travels with the first account request, so the word list
    -- stays in one place in this codebase.
    directory.pilot_name = menu.name
    directory.open(menu.directory)
end

-- Who a ship id belongs to. The server's roster, because those are other
-- people and only it knows their names. Everything that names a pilot goes
-- through here, or the feed ends up reading "ship 5 killed ship 8" in a zone
-- full of people.
local function pilot_name(i)
    local p = net.pilots[i]
    return (p and p.name) or ("ship " .. i)
end

-- One line in the notification feed. Kills are what it was built for and are
-- still most of what it carries, but anything worth telling the player about
-- in a sentence belongs here rather than in a second widget: it is already
-- the place they look to find out what just happened.
local function notify(text, col)
    table.insert(feed, 1, {text = text, col = col, t = 0})
    while #feed > ui.FEED_MAX do table.remove(feed) end
end

-- Every report the simulation made this tick, turned into light, noise and
-- feed lines. Drained per tick rather than per frame: a frame can advance the
-- simulation eight times, and the event list is replaced by each one.
-- Kills come off the wire rather than out of the local simulation. The local
-- death event still drives the explosion, but as a feed line it printed the
-- same kill once per rollback: prediction runs a few ticks ahead, a snapshot
-- from before the death revives the victim, and the next predicted ticks
-- kill them again. The zone announces each death exactly once, with what it
-- paid, and that message is already how ratings arrive.
local function drain_kills()
    for _, k in ipairs(net.kills) do
        local vn = pilot_name(k.victim)
        -- Your own bomb counts as your kill in the ledger, which is correct
        -- and reads as nonsense in a feed line.
        -- The payout is shown when there is one. A pilot who was carrying
        -- nothing is worth nothing, and the line says so by staying quiet
        -- rather than by printing a zero.
        local paid = (k.paid > 0 and k.killer ~= 255 and k.killer ~= k.victim)
            and (" (+" .. k.paid .. ")") or ""
        -- Two lines out of every feed are about you, and they are the two
        -- worth finding without reading: green when you took somebody, red
        -- when somebody took you. Everything else stays the feed's own colour,
        -- because a feed where every line is lit says nothing by lighting one.
        --
        -- Yours outranks theirs when you managed both at once, which is a
        -- pilot who blew themselves up with the kill: that is your kill, and
        -- it is the line you will want to see.
        local col = nil
        if k.killer == me and k.victim ~= me then
            col = pal.PRIZE
        elseif k.victim == me then
            col = pal.HURT
        end
        notify((k.victim == k.killer) and (vn .. " was caught in it")
            or (k.killer == 255) and (vn .. " flew into the wall")
            or (pilot_name(k.killer) .. " killed " .. vn .. paid), col)
    end
    if #net.kills > 0 then net.kills = {} end
end

local function drain_events()
    world.events(me, sfx.play)
    -- What the events cannot say, because they are this client's own
    -- simulation talking and it simulates one pilot. Both of these read the
    -- state instead, so they go here rather than in the loop below.
    world.charges(me, sfx.play)
    world.shots(me, sfx.play)
    for i = 0, sim.event_count() - 1 do
        local ty, a, b, v = sim.event_at(i)
        if ty == sim.EV_HIT and a == me then
            hurt = 1
        elseif ty == sim.EV_PRIZE and a == me then
            local col, name = pal.prize(b)
            -- v is the sign: a green can take as well as give, and the feed
            -- is the one place that says which happened.
            local up = v >= 0
            if not up then col = pal.RUST end
            pickup = {name = name, col = col, t = 1, sign = up and "+" or "-"}
            notify((up and "+ " or "- ") .. name, col)
        elseif ty == sim.EV_FLAG_TAKE or ty == sim.EV_FLAG_DROP then
            local col = (sim.ship_team(a) == sim.ship_team(me))
                and pal.FRIEND or pal.ENEMY
            notify(pilot_name(a) ..
                (ty == sim.EV_FLAG_TAKE and " took a flag" or " dropped a flag"),
                col)
        end
    end
end

-- One predicted tick. The server owns the arena, so this sends buttons and
-- replays its own ship; nothing else in the world is stepped here.
local function step_once()
    if net.step(my_buttons()) then drain_events() end
end

-- Text entry on the web goes through real inputs laid over the fields, because
-- a canvas cannot hold a caret and a phone will not raise a keyboard for
-- something that was never focused. There is none left in this client, which
-- is why nothing here talks to the page but the hand-off at the end of the
-- first drawn frame.
function init(self)
    msg.post(".", "acquire_input_focus")
    math.randomseed(1)
    -- Before anything can ask for a sound. The components start out pointed at
    -- silence and this is what puts audio behind them.
    sfx.init()
    -- Wanted from the first frame. It will not start until the page has been
    -- touched and the audio device is awake, which is why this is a request
    -- the frame loop keeps making rather than a call that either works or
    -- does not. See sfx.music_tick.
    sfx.music(true)

    layers = {
        -- The static layers are built when the camera leaves its window and
        -- uploaded when the camera leaves its window rather than per frame,
        -- but *drawn* every frame in full, so a capacity is a per-frame cost
        -- and not only memory. That is why these two start at a guess and are
        -- then sized against what the map in front of them actually needs;
        -- see fit_static. They used to be fixed at 32768 and 98304, chosen for
        -- the densest window of the densest map and paid for over every empty
        -- one.
        bg = vec.layer("#bg", STATIC_SEED),
        bgglow = vec.layer("#bgglow", STATIC_SEED),
        -- These three go up every frame, whole, however little of them is
        -- used, so the headroom is bandwidth spent on nothing, and these are
        -- sized against what a heavy frame actually measures (fill 2.8k, glow
        -- 3.8k, ui 2.1k) with room to spare rather than by an order of
        -- magnitude.
        fill = vec.layer("#fill", 6144),
        -- Raised from 8192 with the detailed hulls. A hull costs up to 780
        -- vertices where the old outline and spine cost 134, so the old
        -- ceiling held ten of them and their fire, and an overflow does not
        -- report itself: the strokes past the cap simply stop being drawn.
        --
        -- Raised again when strokes got their falloff, which took the worst
        -- hull from 780 vertices to 1176 and this ceiling from twenty-one
        -- hulls down to thirteen. Chaos seats sixty-four. Back to twenty.
        glow = vec.layer("#glow", 24576),
        -- The same falloff, on an interface that is mostly strokes: measured
        -- at every layout and both toggles, the busiest went from 2.1k
        -- vertices to 3639 against a ceiling of 4096, which is a margin too
        -- thin to hold a scoreboard that grows with the room.
        --
        -- Raised again for the map, which is the whole arena as rectangles and
        -- the one thing here whose size is a property of the zone rather than
        -- of the layout. Merged into greedy blocks the three shipped maps come
        -- to 928, 1376 and 2195 of them, so 24576 holds the worst of those
        -- with the rest of the interface still under it.
        ui = vec.layer("#ui", 24576),
    }

    -- A generated call sign, restored if this browser has one already. The
    -- configuration still wins, which is how a test names its clients.
    menu.load_identity()
    -- The account secret this device already holds, if any. Logging in waits
    -- until the games list says where the meta-layer is.
    account.load()
    menu.defaults(sys.get_config_string("vectorwake.name", ""),
                  sys.get_config_string("vectorwake.directory", ""))

    sim.init(0x5eed)

    -- A pinned server means go here and do not ask, which is what a test and
    -- an operator's own build want. Everybody else gets the menu.
    local url = sys.get_config_string("vectorwake.server", "")
    if url ~= "" then
        -- The server owns state from here, but the core still needs its map
        -- and settings: prediction runs collision locally between snapshots,
        -- and a snapshot carries state, not rules.
        menu.home = false
        menu.note = "joining"
        net.connect(url, menu.class,
                    sys.get_config_string("vectorwake.name", "pilot"),
                    function(why)
                        menu.note = why
                        go_home(self, "zones")
                    end)
        self.online = true
        self.joining = 0
        return
    end

    go_home(self)
end

function final(self)
    msg.post(".", "release_input_focus")
end

-- Whether a ship is burning its engine this frame, which is the only thing on
-- screen that separates a pilot accelerating from one coasting.
--
-- Only your own. Buttons are not in a snapshot, so what anybody else is doing
-- with their engine is not something this client is told.
local function burning(i, mine_buttons, bit)
    return i == me and has(mine_buttons, bit)
end

-- Bank, read off the heading rather than off the buttons, because buttons are
-- yours alone and everybody's ship should lean into a turn. Watching the
-- heading move is the one signal the client has for every seat.
--
-- The rate is smoothed on about a tenth of a second. Remote headings arrive
-- in snapshot steps, so raw differences are a spike and four zeroes; smoothed
-- they are the turn the pilot is actually making. It also eases your own bank
-- in and out instead of snapping it on with the key.
--
-- Purely visual, per decision 5: nothing here touches the simulation, and a
-- rolled hull's collision radius is whatever the core says it is.
local TAU = 2 * math.pi
local FULL_TURN = 3.0        -- rad/s of turn that earns the whole bank;
                             -- an unupgraded hull turns at about pi
-- Radians of roll at that rate. Fifty-four degrees, so a hull holding a turn
-- draws at 58% of its width against the 75% it did: the first pass was a lean
-- you had to be told about. Past about sixty the wings foreshorten faster than
-- the eye reads them as wings and the class stops being legible from its
-- silhouette, which identity.md puts above any of this.
local MAX_BANK = 0.95

local function ship_roll(i, heading, dt)
    local s = rolls[i]
    if not s then
        s = {h = heading, v = 0}
        rolls[i] = s
    end
    local dh = heading - s.h
    s.h = heading
    if dh > 32768 then dh = dh - 65536
    elseif dh < -32768 then dh = dh + 65536 end
    -- A jump no rudder reaches inside a frame is a respawn or a seat handed
    -- to somebody new, and neither is a turn.
    if dt <= 0 or dh > 4096 or dh < -4096 then
        s.v = 0
        return 0
    end
    local rate = dh / 65536 * TAU / dt
    s.v = s.v + (rate - s.v) * (1 - math.exp(-dt / 0.11))
    local k = s.v / FULL_TURN
    if k > 1 then k = 1 elseif k < -1 then k = -1 end
    return k * MAX_BANK
end

function update(self, dt)
    local ww, wh = self.vw or 0, self.vh or 0
    local density = self.density or 1
    if ww == 0 or wh == 0 then return end

    sfx.frame()
    -- The soundtrack wants to be running from the first frame and cannot be,
    -- so it is asked for repeatedly until it is. See sfx.music_tick.
    sfx.music_tick(dt)

    -- Is there a game to look at? A zone that has taken the connection but not
    -- yet sent a snapshot has no world in it, so the menu holds the screen
    -- until one lands, with the note under it saying what is being waited on.
    local live = self.online and net.connected and sim.ship_count() > 0
    menu.home = not live
    -- Nothing behind the panel means the panel does not go away. This is the
    -- one place that decides it; `menu.close` refuses while `home` is set.
    if not live then menu.open = true end

    -- Fixed 100 Hz stepping under our own accumulator rather than Defold's
    -- fixed_update: prediction and rollback want this clock, not the physics
    -- timestep, and Defold's physics is off entirely.
    -- A digit spends its row of the corner stack directly, the way a charge
    -- pad already does on a touchscreen: the number you press is the row you
    -- read. By row rather than by absolute slot, so a hull that carries only
    -- some slots still puts 1 on the first thing listed. Latched like the
    -- pad's tap, and for the same reason: the press has to survive until a
    -- simulation step spends it.
    if not menu.open then
        for i = 1, 4 do
            if tapped[hash("charge_" .. i)] then
                tapped[hash("charge_" .. i)] = nil
                local slot = my_slots()[i]
                if slot then key_charge = slot end
            end
        end
    end

    if self.online then
        accum = accum + math.min(dt, 0.25)
        local steps = 0
        while accum >= DT and steps < MAX_CATCHUP do
            -- Read once, before anything asks for the buttons, and cleared
            -- after the step that spends it.
            charge_tap = touch.fired_charge() or key_charge
            key_charge = nil
            step_once()
            charge_tap = nil
            accum = accum - DT
            steps = steps + 1
        end
        if steps == MAX_CATCHUP then accum = 0 end
    else
        accum = 0
    end

    -- Escape opens the menu; inside it, escape goes back a level, and at the
    -- root that is the same as closing. One key, no modes.
    --
    -- Except that it shuts what is already open first, innermost outwards: the
    -- box about a pilot, then the info panel that box was opened from. Escape
    -- is the key a player reaches for to dismiss whatever they are looking at,
    -- and answering it with a menu is answering a question nobody asked while
    -- leaving the thing they meant standing behind it.
    if tapped[hash("menu")] and not menu.open then
        local shut = nil
        if ui.inspect then
            ui.inspect = nil
            shut = true
        elseif ui.details then
            toggle_details()
            shut = true
        end
        if shut then
            tapped[hash("menu")] = nil
            sfx.ui("ui_move")
        end
    end
    if tapped[hash("menu")] and not menu.open then
        toggle_menu()
        tapped[hash("menu")] = nil
        sfx.ui("ui_go")
    end
    -- The scoreboard and your loadout, together, on one key and one chip.
    -- Not gated on the menu being shut: asking for this while the menu is up
    -- is a way of saying you wanted the other one. It is gated on there being
    -- a game, because with no arena behind the menu there is nothing to show
    -- and the toggle would be a key that does nothing.
    if tapped[hash("details")] then
        tapped[hash("details")] = nil
        if live then
            toggle_details()
            sfx.ui("ui_move")
        end
    end
    -- The whole map, on the same terms: gated on there being an arena, since
    -- the menu with nothing behind it has no map to show.
    if tapped[hash("map")] then
        tapped[hash("map")] = nil
        if live then
            toggle_map()
            sfx.ui("ui_move")
        end
    end
    -- The games list is polled only while it is the thing being read: how busy
    -- each game is moves under a player looking at it, and matters not at all
    -- while they are three levels away setting the volume or in a fight. Told
    -- both ways round, because stopping is what makes the next look start with
    -- a fresh ask rather than with a count from ten minutes ago.
    if menu.open and menu.at() == "zones" then
        directory.tick(dt)
    else
        directory.idle()
    end
    -- The arena reads the name off the token, so the menu showing a different
    -- one would be showing a name nobody else can see.
    menu.adopt_account_name()

    if menu.open then
        menu.tick()
        local act, moved = menu.step({
            left = tapped[hash("turn_left")], right = tapped[hash("turn_right")],
            up = tapped[hash("thrust")], down = tapped[hash("reverse")],
            -- Enter and the trigger, which is the button a thumb already has.
            -- A pointer press commits through the hit boxes instead, because
            -- a pointer has a position and "wherever you touched" is a choice
            -- the keyboard does not have to make.
            go = tapped[hash("select")] or tapped[hash("guns")],
            back = tapped[hash("menu")] or tapped[hash("cancel")],
        })
        if moved then sfx.ui(act and "ui_go" or "ui_move") end
        if act then apply_menu(self, act) end
    end
    tapped = {}

    if self.online and net.connected then me = net.me end

    -- A zone that accepts the socket but never sends a snapshot is as broken
    -- as one that refuses it, and on the web a connection to a dead port can
    -- hang without ever raising an error. Either way the player gets the menu
    -- back with a reason on it rather than a black arena.
    if self.online and self.joining then
        if net.connected and net.stats.snaps > 0 then
            menu.home = false
            menu.close()
            menu.note = nil
            self.joining = nil
        else
            self.joining = self.joining + dt
            if self.joining > 10 then
                menu.note = "no answer from the zone"
                go_home(self, "zones")
            end
        end
    end

    -- Asked again, because the answer can have changed since the top of the
    -- frame. A menu row can join a zone, leave one, or give up on a join, and
    -- all three tear the world down mid-frame: joining calls `sim.init` and
    -- leaves nothing to draw until the first snapshot. Carrying the old answer
    -- down to the drawing below would read the empty core as though a game were
    -- still in it, and rebuild terrain around tile zero on the way past.
    live = self.online and net.connected and sim.ship_count() > 0
    menu.home = not live
    if not live then menu.open = true end

    -- Kills the zone announced since last frame, before the expiry pass so
    -- a line's clock starts the frame it appears.
    drain_kills()

    -- Notifications expire. A feed that only ever scrolls leaves the last few
    -- deaths on screen through a lull, which reads as a fight that is still
    -- happening somewhere.
    for i = #feed, 1, -1 do
        feed[i].t = feed[i].t + dt
        if feed[i].t > ui.FEED_LIFE then table.remove(feed, i) end
    end

    -- What the debug readout reports about this client rather than about the
    -- connection. Averaged over a second, because a per-frame figure is a
    -- number nobody can read: it changes faster than the eye resolves and the
    -- interesting question is what the last second looked like, not what this
    -- frame did. Counted whether or not anybody is looking, so opening the
    -- readout shows a settled figure rather than a second of zeroes.
    -- Whether the keyboard lock still holds, once a second. The template
    -- clears the flag on any exit from fullscreen, including the browser's
    -- own hold-escape, so this is a read rather than a guess; a second of
    -- Ctrl doing nothing after an exit is well inside what a hand notices.
    self.lock_t = (self.lock_t or 1) + dt
    if self.lock_t >= 1 then
        self.lock_t = 0
        if html5 then
            local ok, r = pcall(html5.run, "window.vwLocked and '1' or ''")
            kb_locked = ok and r == "1"
        end
    end

    self.perf_t = (self.perf_t or 0) + dt
    self.perf_frames = (self.perf_frames or 0) + 1
    if self.perf_t >= 1.0 then
        self.fps = self.perf_frames / self.perf_t
        self.frame_ms = 1000 * self.perf_t / self.perf_frames
        -- Clamped at zero, because a reconnect replaces the counters and the
        -- reading held from before it is then larger than the one after.
        self.rx_rate = math.max(0, net.stats.rx - (self.rx_was or 0)) / self.perf_t
        self.tx_rate = math.max(0, net.stats.tx - (self.tx_was or 0)) / self.perf_t
        self.rx_was, self.tx_was = net.stats.rx, net.stats.tx
        self.perf_t, self.perf_frames = 0, 0
    end

    -- Where this frame falls between the two ticks either side of it, and how
    -- much of the last correction has been walked off. Everything that reads a
    -- position below gets both folded in, including the camera, so the whole
    -- scene moves together rather than the world sliding under a hull that is
    -- being smoothed on its own.
    --
    -- Set even when there is no game: the menu's drifting starfield does not
    -- ask the core for anything, but a stale alpha left over from the last
    -- arena would be waiting for the next one.
    sim.render_alpha(accum / DT)
    if live then sim.smooth_decay(dt) end
    local cx, cy
    if live then
        -- What the menu calls your hull is whatever you are flying, asked
        -- every frame rather than remembered: the server decides, and it can
        -- refuse a change the menu has already drawn as chosen.
        menu.class = sim.ship_class(me)
        cx, cy = sim.ship_x(me), sim.ship_y(me)
        -- Terrain follows the camera. A map this size cannot be meshed whole,
        -- so the window is rebuilt once the camera has walked far enough that
        -- its edge is getting close to the screen.
        local ctx, cty = math.floor(cx / 16), math.floor(cy / 16)
        if not static_tx or math.abs(ctx - static_tx) >= STATIC_STEP
           or math.abs(cty - static_ty) >= STATIC_STEP then
            rebuild_static(ctx, cty)
        end
    else
        -- Nothing to look at, so the camera drifts and the starfield moves
        -- under the panel. A still field reads as a screenshot of a game
        -- rather than a game waiting to be picked.
        self.drift = (self.drift or 0) + dt * 7
        cx, cy = 512 * 16 + self.drift, 512 * 16 + self.drift * 0.4
    end

    sfx.listener(cx, cy)
    fx.listener(cx, cy)
    fx.update(dt)
    hurt = hurt * (0.955 ^ (dt * 60))
    if pickup then
        pickup.t = pickup.t * (0.975 ^ (dt * 60))
        if pickup.t < 0.02 then pickup = nil end
    end

    local sx, sy = fx.shake_offset()
    msg.post("@render:", "camera",
             {position = vmath.vector3(cx + sx, cy + sy, 0)})

    -- A heartbeat, which is the only way to see anything in a headless
    -- build and cheap enough to leave in.
    self.report = (self.report or 0) + dt
    if self.report > 5 then
        self.report = 0
        if live then
            -- Name every pilot the server says is here. The roster is the
            -- point: it is how you know somebody else showed up, and it is the
            -- first thing to break when they do.
            local who = {}
            for i = 0, sim.ship_count() - 1 do
                local p = net.pilots[i]
                who[#who + 1] = (p and p.name or ("?" .. i))
                    .. ((p and p.ai) and "*" or "")
            end
            print(string.format("tick %d  ships %d  err %.2fpx  roster %s",
                sim.tick(), sim.ship_count(), net.stats.err,
                table.concat(who, " ")))
        else
            print(string.format("menu  zone %s  games %d  %s",
                menu.zone == "" and "-" or menu.zone,
                #directory.rows, menu.note or directory.note or ""))
        end
    end

    -- --- the world -------------------------------------------------------
    local fill, glow = layers.fill, layers.glow
    fill:reset()
    glow:reset()

    -- Stars first, and into the per-frame layer: they move against the
    -- camera, so they cannot live in the mesh the walls are baked into. They
    -- are the whole of the home screen's backdrop and the bottom of the
    -- arena's, which is one routine either way.
    world.stars(fill, glow, cx + sx, cy + sy, self.hw, self.hh)

    -- The home screen's own art, over the starfield and under the menu. Only
    -- there: with a game behind it the arena is the picture, and a hull
    -- nobody is flying crossing the middle of it would be a lie.
    if not live then
        world.home_art(fill, glow, cx, cy, self.hw or 0, self.hh or 0,
                       self.drift / 7)
    end

    if live then
        -- A zone's map replaces whatever was there, and the terrain mesh is
        -- built on the assumption that never happens. Rebuilt here rather than
        -- where the message lands: this is the phase that owns the layers, and
        -- a static buffer refilled from the middle of a frame does not survive
        -- it.
        if net.map_epoch ~= (self.map_epoch or 0) then
            self.map_epoch = net.map_epoch
            rebuild_static()
            -- The map view is the one thing that reads all thousand tiles, so
            -- it is built here with the terrain and never again. Doing it on
            -- the first press instead would put a scan of the whole arena in
            -- the frame somebody asked to see it.
            world.build_overview()
        end
        -- Same reason, for what a weapon looks like: a zone's spec table is
        -- its own, so a bolt here can be a bomb there, and the drawing code
        -- caches that answer per spec id.
        if net.settings_epoch ~= (self.settings_epoch or 0) then
            self.settings_epoch = net.settings_epoch
            world.forget_specs()
        end

        local t = sim.tick() / TICK_HZ
        local my_team = sim.ship_team(me)
        local mine_buttons = my_buttons()

        -- Held thrust is the one sound with a duration rather than an instant,
        -- so it is a loop the frame turns on and off rather than an event.
        -- Edges only: playing a looping component again starts a second voice.
        sfx.loop("thrust", sim.ship_alive(me) == 1 and not menu.open
            and (has(mine_buttons, sim.BTN_THRUST)
                 or has(mine_buttons, sim.BTN_REVERSE)))

        world.flags(fill, glow, my_team, t)
        -- What is on screen, grown by enough that nothing pops at the edge: a
        -- bomb's halo is 13 px, a hull's is 26, a blast reaches further.
        -- Drawing the rest of a thousand-tile map is not merely wasted work,
        -- it overflows the layer and the primitives that fall past the cap
        -- simply vanish, which reads as hulls changing shape and energy bars
        -- blinking empty rather than as a slow frame.
        local cull = {x0 = cx - self.hw - 96, x1 = cx + self.hw + 96,
                      y0 = cy - self.hh - 96, y1 = cy + self.hh + 96}
        -- Before anything that flies. A rock's body is opaque and the fill
        -- layer composites in write order, so drawn later it would paint over
        -- a ship passing in front of one.
        world.draw_rocks(fill, glow, t, cull)
        world.prizes(fill, glow, t, cull)
        world.weapons(fill, glow, my_team, t, cull)

        for i = 0, sim.ship_count() - 1 do
            -- Yours is always drawn: the camera is on it, so it cannot be off
            -- screen, and a frame that skipped it would be a frame with no
            -- ship.
            if sim.ship_alive(i) == 1
               and (i == me or not (sim.ship_x(i) < cull.x0 or sim.ship_x(i) > cull.x1
                                    or sim.ship_y(i) < cull.y0 or sim.ship_y(i) > cull.y1)) then
                local col = (sim.ship_team(i) == my_team) and pal.FRIEND or pal.ENEMY
                -- Plates, panel lines and lamps only within the fight you are
                -- actually in. A hull draws the same size wherever it is on
                -- screen, so this is not a level of detail in the usual sense;
                -- it is a cap on what a dogpile can ask of the glow layer,
                -- which does not report an overflow, it just stops drawing.
                local dx = sim.ship_x(i) - cx
                local dy = sim.ship_y(i) - cy
                local hdg = sim.ship_heading(i)
                world.ship(fill, glow, sim.ship_class(i), sim.ship_x(i),
                           sim.ship_y(i), hdg, col, {
                    mine = i == me,
                    far = dx * dx + dy * dy > DETAIL_R2,
                    thrusting = burning(i, mine_buttons, sim.BTN_THRUST),
                    reversing = burning(i, mine_buttons, sim.BTN_REVERSE),
                    flicker = (sim.tick() * 7 + i * 13) % 11 / 11,
                    roll = ship_roll(i, hdg, dt),
                })
                -- Only the wounded carry a pip. A bar over every hull in a
                -- nine-ship room is noise; a bar over the one that is hurt is
                -- the single most useful thing on screen, and its appearing
                -- is itself the notice that something hit you, which is why it
                -- is absent at full rather than merely empty.
                --
                -- Your own grades from team colour into the hurt colours as it
                -- falls. That used to be the corner bar's job and the corner
                -- bar is gone: without this a pilot at eight percent and a
                -- pilot at ninety would be told the same thing in the same
                -- colour, and the length of a 22-pixel bar is not a warning.
                local frac = sim.ship_energy(i) / math.max(1, sim.ship_max_energy(i))
                if frac < 0.995 then
                    local bar_col = col
                    if i == me then
                        if frac < 0.2 then bar_col = pal.HURT
                        elseif frac < 0.45 then bar_col = pal.ENEMY end
                    end
                    world.ship_bar(fill, glow, sim.ship_x(i), sim.ship_y(i), frac,
                                   bar_col)
                end
            end
        end

        -- Scenery that belongs above the ships, now that they are drawn.
        world.draw_over(glow, cull)

        -- Two of the eight hulls have no bomb rack, so the pad that fires one
        -- has nothing to fire. Told every frame rather than on the hull
        -- change, because a zone can hand you a different ship than the one
        -- you asked for.
        touch.has_bomb = sim.has_trigger(me, sim.TRIG_BOMB)
        -- Which charge slots this hull carries, and how many of each are in
        -- hand. The pads are built from this, so a hull with none draws none
        -- and a zone that fills all four gets four.
        touch.charges = my_slots()
        touch.counts = {}
        for _, k in ipairs(touch.charges) do
            touch.counts[k] = sim.ship_charge(me, k)
        end

        -- Doors and wormholes: world geometry that moves, so it cannot live in
        -- the static mesh the way the walls do.
        world.draw_tiles(fill, glow, t, cull)
        fx.draw(glow)
    else
        sfx.loop("thrust", false)
    end

    fill:flush()
    glow:flush()

    -- --- the interface ---------------------------------------------------
    ui.begin(layers.ui, ww, wh, density, touch.used)
    -- The interface stays up under the menu. Nothing is paused, so hiding the
    -- scoreboard and the radar behind a panel would be a lie about what is
    -- happening: you can be shot while reading this.
    if live then
        ui.hud({
            me = me, class_names = CLASS_NAMES, menu_open = menu.open,
            -- The server's roster, because those are other people's names and
            -- only it knows them.
            pilots = net.pilots,
            -- The sides, as the zone is willing to describe them. A pilot's
            -- box names the one they are on only when the zone marked it
            -- public, so what may be said comes from here rather than from a
            -- team byte the client could read off any ship.
            teams = net.teams,
            -- Whether that box should also offer to invite whoever it is
            -- describing, and who has already been asked. Both are the
            -- connection's business, so they are read here rather than in the
            -- renderer, which knows about drawing and not about sides.
            may_invite = net.may_invite(), invited = net.invited,
            feed = feed, hurt = hurt, pickup = pickup,
            charges = charge_row(),
            cam_x = cx, cam_y = cy,
            half_w = self.hw, half_h = self.hh,
            -- Flags are drawn as flags now, so the banner is only for the
            -- things that are genuinely a sentence.
            banner = net.banner,
            -- The round trip, in ticks of a centisecond, which the readout
            -- above the dial turns into four bars. The prediction error that
            -- used to be printed here was this client debugging itself on a
            -- player's screen; it is in the debug readout now, behind the
            -- bars, where somebody who wants it can ask for it.
            lag = net.stats.lag,
            stats = net.stats, zone = net.zone,
            fps = self.fps, frame_ms = self.frame_ms,
            rx_rate = self.rx_rate, tx_rate = self.tx_rate,
        })
    end
    if menu.open then ui.menu(menu.view()) end
    -- Not over the menu: the stick and the pads belong to flight, and drawn
    -- under a panel they read as buttons that do nothing.
    if live and not menu.open then
        touch.draw(layers.ui, ww, wh, density)
    end
    -- The pointer, last, so it rides over everything it points at. The page
    -- hides the browser's cursor over the canvas, and this is the one drawn
    -- in its place: it holds while the mouse is in use, fades once the hand
    -- has been still for a moment, and comes back on any movement or click.
    -- Only where the real one is actually hidden, which is the html5 build;
    -- anywhere else this would be a second arrow under the system's. A
    -- touchscreen has no pointer and gets nothing.
    self.cursor_idle = (self.cursor_idle or 0) + dt
    if html5 and self.cursor_x and not touch.used then
        -- A drawn pointer must not outlive its mouse. Once the pointer is
        -- off the canvas the real cursor is already showing somewhere else
        -- on the desktop, so this one goes at once instead of fading; the
        -- template keeps the flag, the engine having no leave event of its
        -- own. Forgetting the position rather than hiding is what makes
        -- both exits cheap: a retired cursor is never polled for again
        -- until the mouse says something new.
        local ok, out = pcall(html5.run, "window.vwPointerOut?1:0")
        local a = math.min(1, (CURSOR_HOLD + CURSOR_FADE - self.cursor_idle)
                              / CURSOR_FADE)
        if (ok and out == "1") or a <= 0 then
            self.cursor_x, self.cursor_y = nil, nil
        else
            ui.cursor(self.cursor_x, wh - self.cursor_y, a)
        end
    end
    ui.finish()

    -- The page draws its own starfield and wordmark while four megabytes of
    -- engine compile. This is the moment it can stop: not when the runtime
    -- initialised, which is seconds earlier, but when there is something on
    -- screen to hand over to.
    if not self.handed_over then
        self.handed_over = true
        if html5 then pcall(html5.run, "window.vwReady && vwReady()") end
    end
end

-- What the menu asked for.
--
-- The menu names an action and decides nothing; this is the only place that
-- knows what any of them mean, which is what keeps the tree a description of
-- itself rather than a second copy of the game.
function apply_menu(self, act)
    if act == "ship" then
        -- With no game on, this is simply the hull you will arrive in.
        if not self.online then
            menu.class = menu.pending
            menu.save_identity()
            return
        end

        -- A hull change is a respawn, not a rebuild: the arena, the score and
        -- everybody else in it carry on, which is the whole reason the menu
        -- can be opened mid-fight at all. You keep your team and your seat;
        -- your upgrades and your place on the map are gone, the same as
        -- dying, because a fresh hull is a fresh bar and it has to cost what
        -- a fresh bar costs.
        --
        -- Alive and full, or nothing. That rule lives in the core so both
        -- sides have exactly one copy of it; the check here is only so a
        -- refusal comes with a reason instead of silence.
        if sim.ship_alive(me) ~= 1 then
            menu.note = "not while you are waiting to respawn"
            return
        end
        if sim.ship_energy(me) < sim.ship_max_energy(me) then
            menu.note = "a hull change needs a full bar"
            return
        end
        -- The server owns the roster, so this asks and the next snapshot
        -- answers. Nothing is predicted: a hull that flickered back would be
        -- worse than one that arrives a frame late.
        net.set_class(menu.pending)
        menu.save_identity()
        menu.close()
        return
    end

    -- Crossing to another side, and founding one. The same gate a hull change
    -- gets, for the same reason and enforced in the same place: the rule lives
    -- in the core so both ends hold one copy, and these checks exist only so a
    -- refusal arrives with a sentence instead of in silence.
    if act == "team" or act == "found" then
        if not self.online then return end
        if sim.ship_alive(me) ~= 1 then
            menu.note = "not while you are waiting to respawn"
            return
        end
        if sim.ship_energy(me) < sim.ship_max_energy(me) then
            menu.note = "changing sides needs a full bar"
            return
        end
        if act == "found" then
            net.found_team()
        else
            net.set_team(menu.pending)
        end
        -- Left open on purpose, unlike a hull change: the team list is what
        -- answers, and closing the menu would hide the answer to the question
        -- just asked.
        return
    end

    if act == "fullscreen" then
        if html5 then
            -- Fullscreen brings the keyboard lock along where the browser has
            -- one, and the lock is what lets Ctrl be a gun: windowed, Ctrl
            -- with Tab is the browser's tab switcher on every platform, and
            -- on a Mac the system takes Ctrl with the arrows before the
            -- browser exists. The template clears vwLocked when fullscreen
            -- goes, however it goes, including Chrome's hold-escape.
            pcall(html5.run, "(document.fullscreenElement" ..
                  " ? document.exitFullscreen()" ..
                  " : document.documentElement.requestFullscreen().then(" ..
                  "function(){return navigator.keyboard&&navigator.keyboard.lock" ..
                  "?navigator.keyboard.lock().then(function(){window.vwLocked=1})" ..
                  ":0}).catch(function(){}))")
        end
        return
    end

    if act == "join" then
        local r = menu.chosen
        if not r then return end
        if not r.live then
            -- The row already says nobody is running it on its right-hand
            -- side, so this only has to not be silent: a press that produces
            -- nothing reads as a dead screen.
            menu.note = "nobody is running " .. r.name
            return
        end
        -- Whatever we were in, we are leaving. `net.connect` drops the old
        -- socket itself, but the world it filled is this script's to clear.
        net.disconnect()
        feed = {}
        pickup = nil
        hurt = 0
        fx.reset()
        world.forget_specs()
        sim.init(0x5eed)
        clear_static()
        me = 0
        directory.close()
        ui.details = false
        ui.map = false
        menu.zone = r.zone
        menu.save_identity()
        menu.note = "joining " .. r.name
        -- The one address serves the whole join: the directory named it, and
        -- the zone's name travels with the request so an instance that has
        -- since changed game refuses rather than surprising anybody.
        net.connect(r.address, menu.class, menu.name, function(why)
            menu.note = why
            go_home(self, "zones")
        end, r.zone)
        self.online = true
        self.joining = 0
        return
    end

    -- Leaving, and giving up on a join that has not landed. Both are the same
    -- act: there is no game, so put the menu back with nothing behind it.
    if act == "leave" or act == "cancel" then
        if self.online then
            menu.note = nil
            go_home(self, "zones")
            -- Made here rather than by the caller. Escape at the root of the
            -- home screen produces this same action and does nothing with it,
            -- and a click for a keystroke that changed nothing is how an
            -- interface teaches a player to stop trusting its noises.
            sfx.ui("ui_go")
        end
        return
    end
end

-- The render script reports the pixel space it projects the interface into.
-- On HTML5 that is not always what window.get_size() says, and the interface
-- has to agree with the projection or it draws off the screen.
function on_message(self, message_id, message)
    if message_id == hash("viewport") then
        self.vw, self.vh = message.w, message.h
        self.hw, self.hh = message.hw, message.hh
        self.density = message.density
        -- How much world one screen pixel covers, which is what stops a
        -- stroke from being drawn thinner than the screen can hold one. Taken
        -- from the projection rather than from the zoom and the pixel ratio,
        -- because those two are what the projection is made of and this way
        -- there is only one place that multiplies them. The interface layer
        -- keeps its own, which is one: it is drawn in pixels already.
        if layers and message.w > 0 then
            local px = message.hw * 2 / message.w
            layers.bg.px = px
            layers.bgglow.px = px
            layers.fill.px = px
            layers.glow.px = px
            -- The terrain mesh has this baked into every face it drew, so a
            -- window meshed against the old one is wrong until it is built
            -- again. Forgetting where it was centred is what asks for that.
            if px ~= self.px then
                self.px = px
                static_tx = nil
            end
        end
        -- The window the terrain has to cover, and the room the two static
        -- layers need to hold it. Both follow the view: see STATIC_STEP.
        if layers and message.hw and message.hw > 0 then
            local need = math.max(message.hw, message.hh) / 16
            local want = math.ceil(need) + STATIC_STEP + 1
            if want < STATIC_MIN then want = STATIC_MIN end
            if want > STATIC_MAX then
                -- Said once, because a gap on a window this wide is now a
                -- deliberate ceiling rather than the bug it used to be, and
                -- somebody looking at one deserves to find out why.
                if static_half ~= STATIC_MAX then
                    print(string.format(
                        "TERRAIN: view wants %d tiles either side, holding at %d",
                        want, STATIC_MAX))
                end
                want = STATIC_MAX
            end
            if want ~= static_half then
                static_half = want
                -- The capacities follow from what the next build measures,
                -- not from the window: see fit_static.
                static_tx = nil
            end
        end
    end
end

function on_input(self, action_id, action)
    -- A press is a press on whatever it landed on. The interface publishes its
    -- own hit boxes in the pixel space it drew them in, so this needs no
    -- second copy of the layout.
    --
    -- `screen_x`/`screen_y`, in drawable pixels counting up from the bottom.
    -- Never `x`/`y`: on HTML5 Defold scales those into the resolution
    -- game.project asks for rather than the size the canvas actually is, so
    -- on any window that is not exactly 1280 by 800 every button was tested
    -- against the wrong place, and on a phone by a factor of three.
    local function hit(x, y)
        local px, py = x, (self.vh or 0) - y
        for _, r in ipairs(ui.hits) do
            if px >= r.x and px <= r.x + r.w
               and py >= r.y and py <= r.y + r.h then
                -- The two hit boxes that exist while the menu is shut.
                if r.action == "open" then
                    toggle_menu()
                    sfx.ui("ui_go")
                    return true
                end
                if r.action == "details" then
                    toggle_details()
                    sfx.ui("ui_move")
                    return true
                end
                if r.action == "map" then
                    toggle_map()
                    sfx.ui("ui_move")
                    return true
                end
                -- Who that is. Clicking the pilot already being read about
                -- closes the box, which is how every other toggle in here
                -- behaves and saves aiming at the X.
                if r.action == "pilot" then
                    ui.inspect = (ui.inspect ~= r.value) and r.value or nil
                    sfx.ui(ui.inspect and "ui_go" or "ui_move")
                    return true
                end
                if r.action == "uninspect" then
                    ui.inspect = nil
                    sfx.ui("ui_move")
                    return true
                end
                -- Ask the pilot the box is about to fly with you. The box
                -- stays open: the reply is the word under it changing, and
                -- closing it would take that away before it could be read.
                if r.action == "invite" then
                    net.invite(r.value)
                    sfx.ui("ui_go")
                    return true
                end
                if r.action == "debug" then
                    ui.debug = not ui.debug
                    sfx.ui("ui_move")
                    return true
                end
                -- A heading picks the column and takes the list back to the
                -- top, because the row somebody was looking at is not the row
                -- that will be there after a re-sort.
                local sort = string.match(r.action or "", "^sort_(%a+)$")
                if sort then
                    if ui.sort ~= sort then
                        ui.sort = sort
                        ui.scroll = 0
                        sfx.ui("ui_move")
                    end
                    return true
                end
                -- The list itself swallows the click so a tap meant for a
                -- pilot's row does not fall through to whatever is behind it.
                if r.action == "scores" then return true end
                if not menu.open then return false end
                local act, moved = (r.action == "stage")
                    and menu.click_stage(r.value) or menu.click(r.value)
                if moved then sfx.ui(act and "ui_go" or "ui_move") end
                if act then apply_menu(self, act) end
                return true
            end
        end
        return false
    end

    -- A press of a real mouse button is a hand on the mouse, so a click
    -- brings the drawn cursor back even when it has not travelled, and it
    -- carries a position because a fully faded cursor has forgotten its
    -- own. Before the handlers below, because the ones that consume a
    -- press return.
    if not touch.used and action.pressed
       and (action_id == hash("pointer")
            or action_id == hash("pointer_alt")) then
        self.cursor_x = action.screen_x or action.x
        self.cursor_y = action.screen_y or action.y
        self.cursor_idle = 0
    end

    if action_id == hash("touch") then
        -- Every touch that went down this frame, not just whichever one the
        -- engine decided was primary: on a phone the finger that reaches the
        -- button is often the second one down.
        if action.touch then touch.note_used() end
        if action.touch then
            for _, t in ipairs(action.touch) do
                if t.pressed and hit(t.screen_x or t.x, t.screen_y or t.y) then
                    return
                end
            end
        end
        touch.on_touch(action, self.vw or 0, self.vh or 0, self.density or 1)
        return
    end
    -- A press and a release that land inside the same engine frame are
    -- dropped before this ever runs: the button state is polled once a frame,
    -- and a down followed by an up between two polls reads as never pressed.
    -- At 60 Hz that needs a sub-16 ms click, which a hand cannot produce, but
    -- an automated one can. Playwright's click() is instantaneous, and under a
    -- software renderer the frames are long enough that every click vanishes.
    -- A test driving this has to hold the button for ~90 ms, or it will
    -- conclude the interface is dead when it is not.
    if action_id == hash("pointer") and action.pressed and not touch.used then
        if hit(action.screen_x or action.x, action.screen_y or action.y) then
            return
        end
    end

    -- The wheel, which belongs to whichever list is on screen: the menu when
    -- it is open, the scoreboard when it is not. Defold reports a wheel notch
    -- as a press and a release of the same action, so only the press counts or
    -- every notch would move two.
    if action_id == hash("wheel_up") or action_id == hash("wheel_down") then
        if action.pressed then
            local d = (action_id == hash("wheel_up")) and -1 or 1
            if not menu.open and ui.details then ui.scroll = ui.scroll + d end
        end
        return
    end

    if action_id == nil then
        -- The mouse, moving. A nil action can arrive without any travel in
        -- it, so movement is the position having changed, not the event
        -- having landed. The position is kept in drawable pixels, the same
        -- space the hit boxes are tested in; the cursor block in update
        -- turns it into a drawn pointer and fades it once the hand is still.
        local mx = action.screen_x or action.x
        local my = action.screen_y or action.y
        if mx ~= self.cursor_x or my ~= self.cursor_y then
            self.cursor_x, self.cursor_y = mx, my
            self.cursor_idle = 0
        end
        return
    end
    local name = action_id
    if action.pressed then held[name] = true; tapped[name] = true end
    if action.released then held[name] = nil end
end
