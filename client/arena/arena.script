-- The arena screen.
--
-- This script owns the frame loop and nothing else about the game. It reads
-- input, calls the simulation core, and draws what the core says is true. No
-- game rule is implemented in Lua, per decision 5: Defold's component update
-- order within a collection is unspecified, and HTML5 builds run Lua 5.1.4
-- rather than LuaJIT, so state distributed across scripts would have neither
-- a defined order nor adequate speed on the platform that matters most.

local net = require("arena.net")
local touch = require("arena.touch")
local browser = require("arena.browser")

local TICK_HZ = 100
local DT = 1 / TICK_HZ
local MAX_CATCHUP = 8      -- ticks per frame; a long stall must not stampede

local CLASSES = {
    {name = "Apex",    color = vmath.vector4(0.31, 0.84, 1.00, 1)},
    {name = "Wedge",   color = vmath.vector4(1.00, 0.82, 0.40, 1)},
    {name = "Chord",   color = vmath.vector4(0.55, 0.89, 0.62, 1)},
    {name = "Anvil",   color = vmath.vector4(1.00, 0.60, 0.36, 1)},
    {name = "Spire",   color = vmath.vector4(0.78, 0.61, 1.00, 1)},
    {name = "Cipher",  color = vmath.vector4(0.66, 0.72, 0.82, 1)},
    {name = "Facet",   color = vmath.vector4(1.00, 0.45, 0.45, 1)},
    {name = "Lattice", color = vmath.vector4(0.35, 0.78, 0.78, 1)},
}

-- Ship outlines in local pixels, nose up. Shape carries class and colour
-- carries team, so neither has to carry both.
local HULLS = {
    {{0, 14}, {8, -10}, {0, -5}, {-8, -10}},                    -- Apex
    {{0, 12}, {11, -9}, {-11, -9}},                             -- Wedge
    {{0, 9}, {13, 2}, {8, -9}, {-8, -9}, {-13, 2}},             -- Chord
    {{0, 11}, {10, 5}, {10, -8}, {0, -12}, {-10, -8}, {-10, 5}},-- Anvil
    {{0, 15}, {7, 0}, {0, -11}, {-7, 0}},                       -- Spire
    {{0, 14}, {4, -3}, {0, -11}, {-4, -3}},                     -- Cipher
    {{0, 10}, {9, 3}, {6, -9}, {-6, -9}, {-9, 3}},              -- Facet
    {{0, 10}, {10, 0}, {0, -10}, {-10, 0}},                     -- Lattice
}

-- The offline roster: hull, team, spawn tile, name. Shared by the cold start
-- and by dropping out of the browser, which are the same game.
local LAYOUT = {
    {0, 1, 486, 486, "Kestrel"}, {3, 1, 538, 486, "Halcyon"},
    {6, 1, 538, 538, "Vantage"}, {2, 1, 486, 538, "Ridgeline"},
    {5, 0, 512, 478, "Sable"},   {7, 0, 478, 512, "Meridian"},
    {1, 0, 546, 512, "Ozone"},   {4, 1, 512, 546, "Tessellate"},
}

local ACTIONS = {
    turn_left = nil, turn_right = nil, thrust = nil, reverse = nil,
    guns = nil, bombs = nil,
}

local held = {}
local me = 0
local pilots = {}
local accum = 0

-- Defold hands on_input a hashed action_id, never the string it was written
-- as in the input binding. Comparing it to a string literal silently yields
-- false for every key ever pressed, which is exactly what it did.
local ACTION_BITS = nil
local function bit_for(action)
    if not ACTION_BITS then
        ACTION_BITS = {
            [hash("turn_left")] = sim.BTN_LEFT,
            [hash("turn_right")] = sim.BTN_RIGHT,
            [hash("thrust")] = sim.BTN_THRUST,
            [hash("reverse")] = sim.BTN_REVERSE,
            [hash("guns")] = sim.BTN_FIRE,
            [hash("bombs")] = sim.BTN_BOMB,
        }
    end
    return ACTION_BITS[action] or 0
end

local function my_buttons()
    -- Collected as a set of distinct bits and summed, rather than or-ed:
    -- HTML5 builds run Lua 5.1, which has no bitwise operators, and a bit
    -- contributed by both the keyboard and the stick must still count once.
    local bits = {}
    local steering = touch.steering()
    for action, down in pairs(held) do
        if down then
            -- Two sources on the rudder would fight; the stick wins while it
            -- is down, and the keys keep everything else.
            local bit = bit_for(action)
            local rudder = bit == sim.BTN_LEFT or bit == sim.BTN_RIGHT
            if not (steering and rudder) then bits[bit] = true end
        end
    end
    for _, bit in ipairs(touch.bits(sim.ship_heading(me))) do
        bits[bit] = true
    end
    local b = 0
    for bit in pairs(bits) do b = b + bit end
    return b
end

-- A bot: reads what the page can read, produces a button bitfield, and has no
-- other channel into the simulation.
local function make_bot(id, skill)
    return {
        id = id, skill = skill, want = 0, timer = id * 7,
        react = math.max(3, math.floor(38 - skill * 30)),
        aim_err = (1 - skill) * 0.42,
        seed = 12345 + id * 7919,
    }
end

local function bot_rand(b)
    b.seed = (b.seed * 1103515245 + 12345) % 2147483648
    return b.seed / 2147483648
end

local function steer(b, dx, dy, sloppy)
    local want = math.atan2(dx, -dy)
    local head = (sim.ship_heading(b.id) / 65536) * math.pi * 2
    local diff = want - head
    if sloppy then diff = diff + (bot_rand(b) - 0.5) * b.aim_err end
    while diff > math.pi do diff = diff - math.pi * 2 end
    while diff < -math.pi do diff = diff + math.pi * 2 end
    local out = 0
    if diff > 0.05 then out = out + sim.BTN_RIGHT
    elseif diff < -0.05 then out = out + sim.BTN_LEFT end
    return out, math.abs(diff)
end

local function bot_think(b)
    if sim.ship_alive(b.id) == 0 then return 0 end
    local mx, my = sim.ship_x(b.id), sim.ship_y(b.id)
    local team = sim.ship_team(b.id)

    -- A loose flag outranks a fight: flags decide the round.
    for i = 0, sim.flag_count() - 1 do
        local fx, fy, fteam, carried = sim.flag_at(i)
        if fteam ~= team and not carried then
            local dx, dy = fx - mx, fy - my
            if dx * dx + dy * dy < 420 * 420 then
                local out, off = steer(b, dx, dy, false)
                if off < 0.5 then out = out + sim.BTN_THRUST end
                return out
            end
        end
    end

    local best, bdx, bdy = nil, 0, 0
    for i = 0, sim.ship_count() - 1 do
        if i ~= b.id and sim.ship_alive(i) == 1 and sim.ship_team(i) ~= team then
            local dx, dy = sim.ship_x(i) - mx, sim.ship_y(i) - my
            local d2 = dx * dx + dy * dy
            if best == nil or d2 < best then best, bdx, bdy = d2, dx, dy end
        end
    end
    if best == nil then return 0 end

    local dist = math.sqrt(best)
    local out, off = steer(b, bdx, bdy, true)
    local ideal = 130 + (1 - b.skill) * 90
    if dist > ideal * 1.15 then out = out + sim.BTN_THRUST
    elseif dist < ideal * 0.55 then out = out + sim.BTN_REVERSE end

    local e = sim.ship_energy(b.id) / math.max(1, sim.ship_max_energy(b.id))
    if off < 0.16 and e > 0.16 + b.skill * 0.28 then
        out = out + sim.BTN_FIRE
    end
    return out
end

function init(self)
    msg.post(".", "acquire_input_focus")
    math.randomseed(1)

    -- A server address makes this a networked client; without one it plays
    -- the same game locally, which is what keeps a build with nothing behind
    -- it playable.
    -- A directory means "let the player choose"; a pinned server means
    -- "go here". Neither means play the local game, which is what keeps a
    -- build with nothing behind it playable.
    local dir = sys.get_config_string("vectorwake.directory", "")
    local url = sys.get_config_string("vectorwake.server", "")
    if url == "" and dir ~= "" then
        sim.init(0x5eed)
        browser.connect(dir)
        self.browsing = true
        return
    end
    if url ~= "" then
        -- The server owns state from here, but the core still needs its map
        -- and settings: prediction runs collision locally between snapshots,
        -- and a snapshot carries state, not rules.
        sim.init(0x5eed)
        net.connect(url, 0, sys.get_config_string("vectorwake.name", "pilot"))
        self.online = true
        return
    end

    sim.init(0x5eed)
    me = sim.spawn(0, 0, 512, 522, 0)
    pilots[me] = {name = "you"}

    for i, L in ipairs(LAYOUT) do
        local id = sim.spawn(L[1], L[2], L[3], L[4], (i * 8192) % 65536)
        pilots[id] = {name = L[5], bot = make_bot(id, 0.28 + (i % 5) * 0.16)}
    end

    for _, f in ipairs({{512, 492}, {532, 512}, {512, 532}, {492, 512}}) do
        sim.add_flag(f[1], f[2])
    end
end

function final(self)
    msg.post(".", "release_input_focus")
end

local function step_once()
    -- Online, the server owns everybody else and this predicts only itself.
    if net.step(my_buttons()) then return end

    local buttons = {}
    buttons[me] = my_buttons()
    for id, p in pairs(pilots) do
        if p.bot then
            local b = p.bot
            b.timer = b.timer + 1
            if b.timer % b.react == 0 then b.want = bot_think(b) end
            buttons[id] = (sim.ship_alive(id) == 1) and b.want or 0
        end
    end
    sim.step(buttons)
end

local function draw_hull(cls, x, y, heading, color)
    local pts = HULLS[cls + 1] or HULLS[1]
    local a = (heading / 65536) * math.pi * 2
    local ca, sa = math.cos(a), math.sin(a)
    local n = #pts
    for i = 1, n do
        local p, q = pts[i], pts[i % n + 1]
        -- Nose up means the local +y axis points along the heading.
        local px = x + p[1] * ca + p[2] * sa
        local py = y - p[1] * sa + p[2] * ca
        local qx = x + q[1] * ca + q[2] * sa
        local qy = y - q[1] * sa + q[2] * ca
        msg.post("@render:", "draw_line", {
            start_point = vmath.vector3(px, py, 0),
            end_point = vmath.vector3(qx, qy, 0),
            color = color,
        })
    end
end

local function start_offline()
    me = sim.spawn(0, 0, 512, 522, 0)
    pilots[me] = {name = "you"}
    for i, L in ipairs(LAYOUT) do
        local id = sim.spawn(L[1], L[2], L[3], L[4], (i * 8192) % 65536)
        pilots[id] = {name = L[5], bot = make_bot(id, 0.28 + (i % 5) * 0.16)}
    end
    for _, f in ipairs({{512, 492}, {532, 512}, {512, 532}, {492, 512}}) do
        sim.add_flag(f[1], f[2])
    end
end

function update(self, dt)
    if browser.open then
        local w, h = window.get_size()
        browser.draw(w, h)
        -- Same heartbeat idea as the arena: without it there is no way to see
        -- what the browser thinks is selected in a headless run.
        self.report = (self.report or 0) + dt
        if self.report > 3 then
            self.report = 0
            print(string.format("browser rows %d sel %d %s",
                #browser.rows, browser.selected, browser.note))
        end
        return
    end
    if self.online and sim.ship_count() == 0 then return end

    -- Fixed 100 Hz stepping under our own accumulator rather than Defold's
    -- fixed_update: prediction and rollback want this clock, not the physics
    -- timestep, and Defold's physics is off entirely.
    accum = accum + math.min(dt, 0.25)
    local steps = 0
    while accum >= DT and steps < MAX_CATCHUP do
        step_once()
        accum = accum - DT
        steps = steps + 1
    end
    if steps == MAX_CATCHUP then accum = 0 end

    -- A heartbeat, which is the only way to see anything in a headless
    -- build and cheap enough to leave in.
    self.report = (self.report or 0) + dt
    if self.report > 5 then
        self.report = 0
        local flags = {}
        for i = 0, sim.flag_count() - 1 do
            local _, _, team = sim.flag_at(i)
            flags[#flags + 1] = tostring(team)
        end
        if self.online then
            print(string.format("tick %d  ships %d  online %s  err %.2fpx  peak %.1fpx  %s",
                sim.tick(), sim.ship_count(), tostring(net.connected),
                net.stats.err, net.stats.err_max, net.banner))
        else
            print(string.format("tick %d  ships %d  hash %d  at %.0f,%.0f  flags %s",
                sim.tick(), sim.ship_count(), sim.hash(),
                sim.ship_x(me), sim.ship_y(me), table.concat(flags, ",")))
        end
    end

    if self.online and net.connected then me = net.me end

    local cx, cy = sim.ship_x(me), sim.ship_y(me)
    msg.post("@render:", "camera", {position = vmath.vector3(cx, cy, 0)})

    -- Touch controls, drawn in world space at a fixed offset from the camera.
    -- The same view extent the render script uses, so they land where the
    -- thumb actually is.
    local ww, wh = window.get_size()
    if ww > 0 and wh > 0 then
        local px = sys.get_config_int("vectorwake.view_tiles", 34) * 16
        local short = math.min(ww, wh)
        touch.draw(cx, cy, px * 0.5 * (ww / short), px * 0.5 * (wh / short), ww, wh)
    end

    -- Walls near the camera.
    local wall = vmath.vector4(0.16, 0.24, 0.38, 1)
    local t0x, t0y = math.floor(cx / 16) - 26, math.floor(cy / 16) - 26
    for ty = t0y, t0y + 52 do
        for tx = t0x, t0x + 52 do
            if sim.solid(tx, ty) then
                local x, y = tx * 16, ty * 16
                msg.post("@render:", "draw_line", {
                    start_point = vmath.vector3(x, y, 0),
                    end_point = vmath.vector3(x + 16, y, 0), color = wall})
                msg.post("@render:", "draw_line", {
                    start_point = vmath.vector3(x, y, 0),
                    end_point = vmath.vector3(x, y + 16, 0), color = wall})
            end
        end
    end

    -- Ships.
    local my_team = sim.ship_team(me)
    for i = 0, sim.ship_count() - 1 do
        if sim.ship_alive(i) == 1 then
            local cls = sim.ship_class(i)
            local col = (i == me) and vmath.vector4(0.31, 0.84, 1, 1)
                or (sim.ship_team(i) == my_team and vmath.vector4(0.5, 0.89, 0.63, 1)
                                                or vmath.vector4(1, 0.5, 0.5, 1))
            draw_hull(cls, sim.ship_x(i), sim.ship_y(i), sim.ship_heading(i), col)
        end
    end

    -- Weapons.
    local shot = vmath.vector4(1, 0.86, 0.4, 1)
    for i = 0, sim.weapon_count() - 1 do
        local x, y = sim.weapon_at(i)
        msg.post("@render:", "draw_line", {
            start_point = vmath.vector3(x - 2, y, 0),
            end_point = vmath.vector3(x + 2, y, 0), color = shot})
    end

    -- Flags.
    for i = 0, sim.flag_count() - 1 do
        local x, y, team = sim.flag_at(i)
        local col = (team == 255) and vmath.vector4(0.56, 0.63, 0.72, 1)
            or (team == my_team and vmath.vector4(0.5, 0.89, 0.63, 1)
                                 or vmath.vector4(1, 0.5, 0.5, 1))
        msg.post("@render:", "draw_line", {
            start_point = vmath.vector3(x, y - 6, 0),
            end_point = vmath.vector3(x, y + 12, 0), color = col})
        msg.post("@render:", "draw_line", {
            start_point = vmath.vector3(x, y + 12, 0),
            end_point = vmath.vector3(x + 11, y + 7, 0), color = col})
    end
end

function on_input(self, action_id, action)
    if browser.open then
        if not action.pressed then return end
        if action_id == hash("thrust") then browser.move(-1)
        elseif action_id == hash("reverse") then browser.move(1)
        elseif action_id == hash("select") then
            local address = browser.chosen()
            if address then
                browser.close()
                net.connect(address, 0,
                            sys.get_config_string("vectorwake.name", "pilot"))
                self.online = true
                self.browsing = false
            end
        elseif action_id == hash("cancel") then
            browser.close()
            self.browsing = false
            start_offline()
        end
        return
    end
    if action_id == hash("touch") then
        local w, h = window.get_size()
        touch.on_touch(action, w, h)
        return
    end
    if action_id == nil then return end
    local name = action_id
    if action.pressed then held[name] = true end
    if action.released then held[name] = nil end
end
