-- Text, and only text.
--
-- Every box, bar, border and blip in this game is triangles in the `vwui`
-- mesh layer, drawn before this one under the same screen-space projection.
-- Glyphs are the one thing a mesh cannot do without an atlas of our own, so
-- they come through the gui, and the division is absolute: if it has a
-- shape, arena/ui.lua drew it; if it has words, this did.
--
-- Nodes are created here rather than authored in the .gui file. The interface
-- is a different shape in the menu than in flight and a different shape again
-- online, and a pool that the layout drives is far less to maintain than
-- three authored screens that have to be kept in agreement with the code.

local state = require("arena.state")

local FONT = "ui"
-- The size each face was built at, since scale here is relative to it.
local SIZES = {ui = 26, menu = 26}
-- The pool is the budget in state.lua, where the side that writes the text
-- can be held to it. It was a number here, 128, and the ending screen with
-- the scoreboard open queued past it: everything after the cut simply did
-- not draw, which took the words off the podium's phrase chips while their
-- boxes, being mesh, stayed. A cap the writer cannot see is a cap somebody
-- finds by screenshot.
local POOL = state.TEXT_POOL

local PIVOTS = {
    left = gui.PIVOT_W,
    right = gui.PIVOT_E,
    center = gui.PIVOT_CENTER,
}

-- What each node was last told, so it is only told again when it changed.
--
-- A scoreboard row reads "0 / 0" for minutes at a time and the controls along
-- the bottom never change at all, but this used to reset the text, pivot,
-- position, scale and color of every node sixty times a second -- six calls
-- into the engine per line, and two fresh vmath values per line for the
-- garbage collector to deal with. The vectors are made once and mutated;
-- Defold copies them into the node, so one object per node is enough.
function init(self)
    self.nodes = {}
    self.was = {}
    for i = 1, POOL do
        local n = gui.new_text_node(vmath.vector3(0, 0, 0), "")
        gui.set_font(n, FONT)
        gui.set_adjust_mode(n, gui.ADJUST_FIT)
        gui.set_enabled(n, false)
        self.nodes[i] = n
        self.was[i] = {
            on = false, s = false, pivot = false, x = false, y = false,
            scale = false, r = false, g = false, b = false, a = false,
            font = FONT,
            pos = vmath.vector3(0, 0, 0),
            sc = vmath.vector3(1, 1, 1),
            col = vmath.vector4(1, 1, 1, 1),
        }
    end
    self.live = 0
    self.version = -1
end

function update(self)
    if state.version == self.version then return end
    self.version = state.version

    local text, count = state.text, state.n
    if count > POOL then count = POOL end

    for i = 1, count do
        local t = text[i]
        local node = self.nodes[i]
        local w = self.was[i]

        if not w.on then gui.set_enabled(node, true) w.on = true end
        if w.s ~= t.s then gui.set_text(node, t.s) w.s = t.s end

        local pivot = PIVOTS[t.pivot] or gui.PIVOT_W
        if w.pivot ~= pivot then gui.set_pivot(node, pivot) w.pivot = pivot end

        -- Two faces: the mono everything in flight is set in, and the menu's.
        -- A node keeps whichever it was last given, so this is the same
        -- compare-then-set every other property here does.
        local font = t.font or FONT
        if w.font ~= font then gui.set_font(node, font) w.font = font end

        if w.x ~= t.x or w.y ~= t.y then
            local p = w.pos
            p.x, p.y = t.x, t.y
            gui.set_position(node, p)
            w.x, w.y = t.x, t.y
        end

        local s = t.px / SIZES[font]
        if w.scale ~= s then
            local v = w.sc
            v.x, v.y = s, s
            gui.set_scale(node, v)
            w.scale = s
        end

        -- `dim` is a whole-layer fade the interface applies to itself, so
        -- it multiplies the alpha rather than replacing the color: a label
        -- keeps its meaning while the menu is over it and simply stops
        -- shouting.
        local c = t.col
        local a = c[4] * (t.dim or 1)
        if w.r ~= c[1] or w.g ~= c[2] or w.b ~= c[3] or w.a ~= a then
            local v = w.col
            v.x, v.y, v.z, v.w = c[1], c[2], c[3], a
            gui.set_color(node, v)
            w.r, w.g, w.b, w.a = c[1], c[2], c[3], a
        end
    end
    for i = count + 1, self.live do
        gui.set_enabled(self.nodes[i], false)
        self.was[i].on = false
    end
    self.live = count
end
