-- Render pipeline.
--
-- Eight passes, and the order is the whole design:
--
--   vwsky      world, alpha      the sky: stars, clouds, the band
--   vwskyglow  world, additive   what the sky puts out: the sun, a comet
--   vwbg       world, alpha      wall interiors, built once per map
--   vwfill     world, alpha      the dark inside of a hull
--   vwglow     world, additive   every bright thing: outlines, bolts, blasts
--   vwfrost    screen, alpha     the blurred scene, inside a button's box
--   vwui       screen, alpha     panels, bars, radar
--   gui        screen            text, and only text
--
-- Additive is what makes the glow layers read as light rather than paint:
-- overlapping bolts brighten instead of stacking, and because addition does
-- not care about order, the static wall edges can share that pass with the
-- per-frame geometry at no cost.
--
-- The sky goes first because it is behind the map, and it was not always. It
-- used to share the fill layer with everything else, over the wall interiors,
-- and each star asked the core whether it stood on a solid tile so it could
-- take itself out of the drawing. Drawn under the map, the wall occludes the
-- sky because it is in front of it, which costs nothing per star and clips to
-- the wall's real edge rather than to the tile the wall is standing in.
--
-- The camera holds a fixed zoom. A bigger window shows more of the arena
-- rather than the same arena drawn larger, which is what the original did and
-- what stops a resize from stretching the world. Small windows are the one
-- exception: below a threshold the camera stands back so a phone is not
-- fighting with a third of a desktop's sight. The rule lives in zoom.lua,
-- where a test can reach it.

local zoom = require("render.zoom")

-- Screen pixels per world pixel. One means the hulls draw at the size they
-- were authored in, which is the reason for that default.
local ZOOM = sys.get_config_number("vectorwake.zoom", 1.0)

function init(self)
    self.sky_pred = render.predicate({"vwsky"})
    self.skyglow_pred = render.predicate({"vwskyglow"})
    self.bg_pred = render.predicate({"vwbg"})
    self.fill_pred = render.predicate({"vwfill"})
    self.glow_pred = render.predicate({"vwglow"})
    self.frost_pred = render.predicate({"vwfrost"})
    self.post_pred = render.predicate({"vwpost"})
    self.ui_pred = render.predicate({"vwui"})
    self.gui_pred = render.predicate({"gui"})
    self.text_pred = render.predicate({"debug_text"})
    -- Device pixels per point of screen.
    --
    -- With high_dpi on, the drawable already is the device-pixel size and
    -- window.get_size() reports the same number, so the ratio between them is
    -- one and tells us nothing -- which is how the interface ended up laid
    -- out in raw device pixels on a phone, at half the size it was meant to
    -- be read at. On the web the browser is the only thing that knows.
    self.dpr = 1
    if html5 then
        local ok, v = pcall(html5.run, "window.devicePixelRatio")
        local n = ok and tonumber(v)
        if n and n > 0.5 then self.dpr = n end
    end
    -- 1.13 moved the buffer constants onto the graphics module.
    self.clear = {
        [graphics.BUFFER_TYPE_COLOR0_BIT] = vmath.vector4(0.020, 0.027, 0.047, 1),
        [graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
    }
    -- The scene target has color and nothing else, so it is cleared with the
    -- ground alone. Clearing a buffer a target does not carry is a warning per
    -- frame at best.
    self.clear_color = {
        [graphics.BUFFER_TYPE_COLOR0_BIT] = self.clear[graphics.BUFFER_TYPE_COLOR0_BIT],
    }
    -- Everything the frost passes need to know is a function of the window,
    -- so these are filled in by `fit_frost` on a resize rather than per frame.
    self.down_const = render.constant_buffer()
    self.down_const.texel = vmath.vector4(0, 0, 0, 0)
    self.across_const = render.constant_buffer()
    self.across_const.blur_step = vmath.vector4(0, 0, 0, 0)
    self.down_axis_const = render.constant_buffer()
    self.down_axis_const.blur_step = vmath.vector4(0, 0, 0, 0)
    self.frost_const = render.constant_buffer()
    self.frost_const.resolution = vmath.vector4(1, 1, 0, 0)
end

-- The three targets the frost is made of, sized to the window.
--
-- Nothing is allocated until something asks to be frosted, because most of a
-- session is a fight and a fight frosts nothing: the arena says when a button
-- that reads through itself is on screen, and until it does this pipeline is
-- the one it always was, drawing straight at the screen.
--
-- The blur runs at a quarter of the window on each axis. A blur is a low pass,
-- so the detail thrown away by the downsample is detail the blur was going to
-- destroy anyway, and a sixteenth of the pixels is what makes three passes of
-- it affordable on a phone. Only the blit that puts the frame back is drawn at
-- the window's own size.
local function fit_frost(self, w, h)
    local bw = math.max(1, math.floor(w / 4))
    local bh = math.max(1, math.floor(h / 4))
    if self.scene == nil then
        local function color(cw, ch)
            return {[graphics.BUFFER_TYPE_COLOR0_BIT] = {
                format = graphics.TEXTURE_FORMAT_RGBA,
                width = cw, height = ch,
                min_filter = graphics.TEXTURE_FILTER_LINEAR,
                mag_filter = graphics.TEXTURE_FILTER_LINEAR,
                u_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
                v_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
            }}
        end
        self.scene = render.render_target("vwscene", color(w, h))
        self.small_a = render.render_target("vwsmalla", color(bw, bh))
        self.small_b = render.render_target("vwsmallb", color(bw, bh))
    elseif self.frost_w == w and self.frost_h == h then
        return
    else
        render.set_render_target_size(self.scene, w, h)
        render.set_render_target_size(self.small_a, bw, bh)
        render.set_render_target_size(self.small_b, bw, bh)
    end
    self.frost_w, self.frost_h = w, h
    self.bw, self.bh = bw, bh
    self.down_const.texel = vmath.vector4(1 / w, 1 / h, 0, 0)
    self.across_const.blur_step = vmath.vector4(1 / bw, 0, 0, 0)
    self.down_axis_const.blur_step = vmath.vector4(0, 1 / bh, 0, 0)
    self.frost_const.resolution = vmath.vector4(w, h, 0, 0)
end

-- Take the frame apart and put it back: downsample, blur across, blur down,
-- then the sharp copy onto the screen. Ends with the blurred copy bound,
-- which is what the frost layer reads.
--
-- These four are opaque writes into targets that are about to be overwritten
-- whole, so blending is off through all of them. Leaving it on would composite
-- the scene against whatever the last frame left in the small targets.
local function draw_frost(self, w, h)
    render.disable_state(graphics.STATE_BLEND)

    render.set_render_target(self.small_a)
    render.set_viewport(0, 0, self.bw, self.bh)
    render.enable_material("down")
    render.enable_texture("tex0", self.scene, graphics.BUFFER_TYPE_COLOR0_BIT)
    render.draw(self.post_pred, {constants = self.down_const})

    render.set_render_target(self.small_b)
    render.enable_material("blur")
    render.enable_texture("tex0", self.small_a, graphics.BUFFER_TYPE_COLOR0_BIT)
    render.draw(self.post_pred, {constants = self.across_const})

    render.set_render_target(self.small_a)
    render.enable_texture("tex0", self.small_b, graphics.BUFFER_TYPE_COLOR0_BIT)
    render.draw(self.post_pred, {constants = self.down_axis_const})
    render.disable_material()

    render.set_render_target(render.RENDER_TARGET_DEFAULT)
    render.set_viewport(0, 0, w, h)
    render.enable_texture("tex0", self.scene, graphics.BUFFER_TYPE_COLOR0_BIT)
    render.draw(self.post_pred)

    render.enable_texture("tex0", self.small_a, graphics.BUFFER_TYPE_COLOR0_BIT)
    render.enable_state(graphics.STATE_BLEND)
end

-- How often the browser is asked for its pixel ratio again, in frames. It
-- was read once at boot, while the page's own reconciler follows it every
-- quarter second and resizes the drawable to match: a browser zoom, or a
-- window moved between a 1x and a 2x monitor, doubled the drawable and left
-- the projection on the boot value, so the whole game drew at half size.
local DPR_EVERY = 30

function update(self)
    local w, h = render.get_window_width(), render.get_window_height()
    if w == 0 or h == 0 then return end
    if html5 then
        self.dpr_frame = (self.dpr_frame or 0) + 1
        if self.dpr_frame >= DPR_EVERY then
            self.dpr_frame = 0
            local ok, v = pcall(html5.run, "window.devicePixelRatio")
            local n = ok and tonumber(v)
            if n and n > 0.5 then self.dpr = n end
        end
    end

    -- A shader cannot read the screen it is writing to, so a frame with frost
    -- in it is drawn into a texture and put back afterwards. See `draw_frost`.
    local frosted = self.frost == true
    if frosted then
        fit_frost(self, w, h)
        render.set_render_target(self.scene)
    end

    render.set_depth_mask(true)
    render.set_stencil_mask(0xff)
    render.clear(frosted and self.clear_color or self.clear)
    render.set_viewport(0, 0, w, h)

    -- Fixed zoom: the half-extent follows the window, so a wider window sees
    -- further rather than seeing the same thing wider.
    --
    -- The drawable is in device pixels and may be denser than the window it
    -- fills; drawing at that density is what keeps the lines sharp instead of
    -- upscaled and soft. Fold the density into the zoom so a ship stays the
    -- same size on screen and only the sharpness changes.
    -- Native retina reports it as a bigger drawable than window; the browser
    -- reports it only through devicePixelRatio. Take whichever knows.
    local density = self.dpr
    local ok, cw = pcall(window.get_size)
    if ok and cw and cw > 0 and w / cw > density then density = w / cw end
    if density < 1 then density = 1 end
    local z = ZOOM * density * zoom.factor(w, h, density)
    local half_w = w * 0.5 / z
    local half_h = h * 0.5 / z
    local cam = self.camera or vmath.vector3(512 * 16, 512 * 16, 0)

    -- The eye sits well off the plane and the clip range is wide. With the
    -- eye one unit out and a range of exactly (-1, 1), everything the game
    -- draws lands on z_ndc = 1.0 -- precisely the far plane, where it is a
    -- rounding error away from being clipped away entirely.
    render.set_view(vmath.matrix4_look_at(
        vmath.vector3(cam.x, cam.y, 10),
        vmath.vector3(cam.x, cam.y, 0),
        vmath.vector3(0, 1, 0)))
    -- Top and bottom are swapped so the simulation's +y renders downward.
    -- Tile coordinates then match the screen, and heading zero is north
    -- rather than south. Without it the whole world is drawn as a vertical
    -- mirror of itself, which nothing reveals until something asymmetric --
    -- a ship with a nose -- has to agree with it.
    render.set_projection(vmath.matrix4_orthographic(
        -half_w, half_w, half_h, -half_h, -100, 100))

    render.enable_state(graphics.STATE_BLEND)
    render.disable_state(graphics.STATE_DEPTH_TEST)

    -- The fragment shader writes premultiplied color, so ordinary
    -- compositing takes ONE as the source factor, not SRC_ALPHA.
    render.set_blend_func(graphics.BLEND_FACTOR_ONE,
                          graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.draw(self.sky_pred)
    render.set_blend_func(graphics.BLEND_FACTOR_ONE, graphics.BLEND_FACTOR_ONE)
    render.draw(self.skyglow_pred)

    -- And the map over the top of it, which is what makes a wall a hole in
    -- the sky rather than a pane of glass with stars behind it.
    render.set_blend_func(graphics.BLEND_FACTOR_ONE,
                          graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.draw(self.bg_pred)
    render.draw(self.fill_pred)

    render.set_blend_func(graphics.BLEND_FACTOR_ONE, graphics.BLEND_FACTOR_ONE)
    render.draw(self.glow_pred)

    if frosted then draw_frost(self, w, h) end

    -- Interface last, in screen space, where one unit is one drawable pixel.
    render.set_view(vmath.matrix4())
    render.set_projection(vmath.matrix4_orthographic(0, w, 0, h, -1, 1))

    render.set_blend_func(graphics.BLEND_FACTOR_ONE,
                          graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    -- The frost goes under the panel that asked for it: a button dims what is
    -- behind it, and what is behind it now is the blurred copy rather than the
    -- fight itself.
    if frosted then
        render.draw(self.frost_pred, {constants = self.frost_const})
        render.disable_texture("tex0")
    end
    render.draw(self.ui_pred)
    render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA,
                          graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.draw(self.gui_pred)
    render.draw(self.text_pred)

    -- The interface positions itself in exactly this pixel space, so it is
    -- told the numbers rather than asking the window for them: on HTML5 the
    -- canvas drawable and the window size are not always the same, and a HUD
    -- laid out against the wrong one lands off the edge of the screen. The
    -- half-extents and the density go with it, so neither the interface nor
    -- the touch layer keeps its own copy of the projection.
    --
    -- Only when one of them has moved. These change on a resize, on a display
    -- swap and on a zoom, and were posted sixty times a second regardless: a
    -- table allocated and copied into the message queue every frame, and an
    -- arena that answered by re-deriving the starfield budget, re-checking two
    -- layer capacities, restating its interest window to the zone and
    -- recomputing the terrain window, all from numbers it had already been
    -- given. Nothing downstream wants the repetition: the view the zone is
    -- told is deduplicated on the wire and resent from the welcome after a
    -- reconnect, and the rest are pure functions of these five.
    if self.vp_w ~= w or self.vp_h ~= h or self.vp_hw ~= half_w
       or self.vp_hh ~= half_h or self.vp_density ~= density then
        self.vp_w, self.vp_h = w, h
        self.vp_hw, self.vp_hh = half_w, half_h
        self.vp_density = density
        msg.post("main:/arena#arena", "viewport",
                 {w = w, h = h, hw = half_w, hh = half_h, density = density})
    end
end

function on_message(self, message_id, message)
    if message_id == hash("camera") then
        self.camera = message.position
    elseif message_id == hash("frost") then
        -- Sent when the answer changes rather than every frame, the way the
        -- viewport message above goes the other way: the whole point of the
        -- flag is that a fight pays nothing for frost it is not drawing.
        self.frost = message.on
    end
end
