#version 140

// A single triangle big enough to cover clip space, so the blur has no seam
// down the middle of the screen where a quad's diagonal would put one. The
// vertex positions ARE clip coordinates: no matrix, nothing to configure,
// the render script cannot point it at the wrong camera.

in highp vec4 position;

out mediump vec2 var_uv;

void main()
{
    var_uv = position.xy * 0.5 + 0.5;
    gl_Position = vec4(position.xy, 0.0, 1.0);
}
