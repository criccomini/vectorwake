# TLS, the client, and routing for one host, under one hostname.
#
# One name, paths underneath, rather than a name per service. That is not a
# stylistic choice; it was bought with an outage.
#
# The first design gave each service its own hostname so Caddy would fetch a
# certificate per name without being told to. It does, and that is the problem: a
# reinstall wipes the volume holding them, deploying by reinstall wiped it six
# times in a day, and Let's Encrypt allows five certificates per week for the
# same name. Three of the four names ran out and the game went dark while the
# host looked perfectly healthy -- the static client still served, because it was
# the one name new enough to still have a certificate.
#
# So: one certificate to lose instead of four, and adding an arena is a path
# rather than a DNS record and a fresh trip to a rate limiter. Deploys no longer
# wipe anything either (see provision.sh and the updater timer), but the number
# of certificates a mistake can burn is now one, and that is the part that does
# not depend on remembering.
#
# {$VW_DOMAIN} lets the same file serve a real deployment and a local one:
# VW_DOMAIN=localhost gives play.localhost, which Caddy signs with its own
# internal CA and browsers resolve to loopback.

# Reachable by raw IP over plain http, which is the only thing that works before
# DNS has propagated and a certificate exists. That window is exactly when a
# fresh host is least diagnosable, so provisioning writes coarse progress here
# and Caddy comes up before the build rather than after it. Nothing secret is
# written: anyone can read this.
http:// {
	handle_path /deploy* {
		root * /srv/deploy
		file_server browse
	}
	handle {
		respond "vectorwake" 200
	}
}

play.{$VW_DOMAIN} {
	# Plain HTTP, so the chain up to Caddy can be checked with curl from
	# anywhere. Everything else here is a WebSocket upgrade, which plenty of
	# networks decline to carry, and "cannot connect" is a useless symptom when
	# the cause could be DNS, the certificate, Caddy, or the game.
	#
	# It says what it can see and no more. This used to answer a bare "ok",
	# which reads as "the service is up" and means only "Caddy is up" -- it
	# answered 200 throughout a reinstall with no game running at all, and
	# fooled its own author.
	handle /health {
		respond "caddy up; this says nothing about the game" 200
	}

	# What a player browses, and what the arenas register over -- though they
	# reach the directory on loopback and never through here.
	handle_path /dir* {
		reverse_proxy 127.0.0.1:9000
	}

	handle_path /a1* {
		reverse_proxy 127.0.0.1:9001
	}

	handle_path /a2* {
		reverse_proxy 127.0.0.1:9002
	}

	# The game itself. It has to come from this origin: a page delivered by a
	# third party under `connect-src 'self'` cannot open a socket to these
	# arenas at all, which is why the published artifact can only ever be the
	# offline practice arena.
	#
	# Compressed, because the bundle is 5 MB of mostly base64-encoded wasm that
	# gzips to 2.9, and egress is the one cost this deployment has.
	handle {
		encode zstd gzip
		root * /srv/play
		file_server
	}
}

# Deliberately absent: the admin surface. docs/architecture/admin.md says a
# secret in a file is not enough to put it on the public internet, and its read
# view needs no token at all, so a route to it would hand a stranger the fleet.
# It listens on loopback and is reached through an ssh tunnel:
#
#   ssh -L 9100:127.0.0.1:9100 root@<host>   then http://127.0.0.1:9100
