# TLS, and routing for one host, under one hostname.
#
# One name, paths underneath, rather than a name per service. That is not a
# stylistic choice; it was bought with an outage.
#
# The first design gave each service its own hostname so Caddy would fetch a
# certificate per name without being told to. It does, and that is the problem: a
# reinstall wipes the volume holding them, deploying by reinstall wiped it six
# times in a day, and Let's Encrypt allows five certificates per week for the
# same name. Three of the four names ran out and the game went dark while the
# host looked perfectly healthy. The static client still served, because it was
# the one name new enough to still have a certificate.
#
# So: one certificate to lose instead of four, and adding an arena is a path
# rather than a DNS record and a fresh trip to a rate limiter. Deploys no longer
# wipe anything either (see provision.sh and the updater timer), but the number
# of certificates a mistake can burn is now one, and that is the part that does
# not depend on remembering.
#
# {$VW_HOST} is the name this host serves, which is not the same as the machine
# it runs on. A central host serves play.vectorwake.net whichever instance is
# currently underneath it, which is what makes a rebuild a DNS update rather
# than a client release; an arena host serves its own name. VW_HOST=play.localhost
# gives a laptop the same shape, signed by Caddy's internal CA.
#
# What each role routes lives in conf.d, and VW_ROUTES is the prefix of the
# files this host imports: `central`, `arena`, or empty for both, which is the
# host that runs everything. The alternative was one file with every route in
# it, where an arena host would answer /dir with a 502 from a directory that was
# never meant to be there.
#
# A prefix rather than a filename with a default, because a Caddyfile default
# only applies to a variable that is unset and not to one set to nothing, and
# the difference is a host that will not start. Empty here means every file,
# which is the safe direction: the worst an unset value can do is route to a
# service this host does not run.

# Reachable by raw IP over plain http, which is the only thing that works before
# DNS has propagated and a certificate exists. That window is exactly when a
# fresh host is least diagnosable, so provisioning writes coarse progress here
# and Caddy comes up before the build rather than after it. Nothing secret is
# written: anyone can read this.
http:// {
	handle_path /deploy* {
		root * /srv/deploy
		file_server browse
	}
	handle {
		respond "vectorwake" 200
	}
}

{$VW_HOST} {
	# Plain HTTP, so the chain up to Caddy can be checked with curl from
	# anywhere. Everything else here is a WebSocket upgrade, which plenty of
	# networks decline to carry, and "cannot connect" is a useless symptom when
	# the cause could be DNS, the certificate, Caddy, or the game.
	#
	# It says what it can see and no more. This used to answer a bare "ok",
	# which reads as "the service is up" and means only "Caddy is up": it
	# answered 200 throughout a reinstall with no game running at all, and
	# fooled its own author.
	handle /health {
		respond "caddy up; this says nothing about the game" 200
	}

	# The same deploy log the plain-http block serves by IP, here so the page
	# has a stable TLS address once a certificate exists. Nothing secret is in
	# it, by the same rule as above: anyone may read it, and its whole value is
	# being readable when things are odd.
	handle_path /deploy* {
		root * /srv/deploy
		file_server browse
	}

	# The routes this host's role actually has processes behind. `handle` blocks
	# are sorted by how specific their path is rather than by the order they are
	# written, so the page's catch-all in central.caddy stays last however these
	# are spliced in. Empty VW_ROUTES imports all of them.
	import /etc/caddy/conf.d/{$VW_ROUTES}*.caddy
}

# The public front page. The game keeps its own origin at play.<domain> because
# its same-origin socket policy is part of the join path; this site is the quiet
# door in front of it. Static files come straight from the checkout, so a push
# moves the page without building or restarting a game process.
{$VW_SITE_HOST:vectorwake.localhost} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.github.com; media-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	# Keep the community door stable without copying the raw invite out of the
	# game origin, where decision 39 says it lives.
	redir /discord https://play.vectorwake.net/discord 302

	# The landing page uses the exact display and instrument fonts from the
	# client, plus its existing browser mark. They are mounted read-only beside
	# the page rather than copied into a second brand kit.
	handle_path /assets/* {
		header Cache-Control "public, max-age=604800"
		root * /srv/site-assets
		file_server
	}

	handle {
		# File names are stable, so revalidate them on every load. ETags keep an
		# unchanged visit cheap and a deploy visible.
		header Cache-Control "no-cache"
		root * /srv/site
		file_server
	}
}

# The admin panel, on a name of its own. An earlier surface lived at /admin
# behind basic auth and was removed as weight; this one earned its way back
# when accounts arrived, because "the admin flag on a vectorwake account" is
# an authority the meta-layer can actually check. The page is static, the
# API is the meta-layer the game already signs in to, and the two share this
# origin so nothing needs CORS. The name is not the boundary: the same
# routes answer under /meta on the front door, and the authorization is a
# per-request flag check on every one of them.
#
# The default in the address is the guard. Only a central host's .env sets
# VW_ADMIN_HOST, so every other role serves this site as admin.localhost: a
# name nobody dials, certified by Caddy's internal CA, never taken to Let's
# Encrypt. An arena host claiming admin.<domain> would sit in a challenge
# retry loop against a name that resolves elsewhere. Mind the trap the
# VW_ROUTES comment above records: this default covers a variable that is
# unset, not one set to empty, which is why the compose file supplies the
# same fallback instead of an empty string.
{$VW_ADMIN_HOST:admin.localhost} {
	# The meta-layer, unstripped: its routes really are /v1/*.
	handle /v1/* {
		reverse_proxy 127.0.0.1:9400
	}

	# The page. Its script and style live in separate files so that this
	# CSP can stay strict; inline anything and the panel goes blank, which
	# is the correct failure. What the policy buys: server text an
	# operator's browser renders (ban reasons are free text) cannot become
	# script, and the page cannot be framed for clickjacking.
	handle {
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
		root * /srv/admin
		file_server
	}
}
